<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Transcriptor.Desktop.MiniModeWindow" Title="Transcriptor — Mini-Mode" Width="420" Height="150" MinWidth="250" MinHeight="52" CanResize="True" WindowDecorations="None" ShowInTaskbar="True" Topmost="True" Background="#14161A" KeyDown="MiniWindow_KeyDown" Closed="MiniWindow_Closed"><Border x:Name="RootBorder" PointerPressed="Root_PointerPressed" BorderBrush="#46505C" BorderThickness="1" CornerRadius="10" Padding="8" Background="#1C1F25"><Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7"><Grid Grid.Row="0" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock x:Name="StateText" Text="● REC" Foreground="#F06A78" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#D7DBE2" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><CheckBox x:Name="TopmostToggle" Content="📌" IsChecked="True" VerticalAlignment="Center" Click="Topmost_Click"/><Button Content="↗" Click="Expand_Click"/><Button Content="×" Click="CloseMini_Click"/></StackPanel></Grid><Grid x:Name="RecordingPanel" Grid.Row="1" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="54,*,48" RowSpacing="4"><TextBlock Grid.Row="0" Grid.Column="0" Text="YO" Foreground="#AAB1BD" VerticalAlignment="Center"/><ProgressBar x:Name="MicLevel" Grid.Row="0" Grid.Column="1" Maximum="100" Height="9" VerticalAlignment="Center"/><TextBlock x:Name="MicLevelText" Grid.Row="0" Grid.Column="2" Text="0%" Foreground="#AAB1BD" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="0" Text="CLIENTE" Foreground="#AAB1BD" VerticalAlignment="Center"/><ProgressBar x:Name="SystemLevel" Grid.Row="1" Grid.Column="1" Maximum="100" Height="9" VerticalAlignment="Center"/><TextBlock x:Name="SystemLevelText" Grid.Row="1" Grid.Column="2" Text="0%" Foreground="#AAB1BD" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock x:Name="SessionText" Grid.Row="2" Grid.ColumnSpan="3" Foreground="#8A92A0" FontSize="10" TextTrimming="CharacterEllipsis"/></Grid><StackPanel x:Name="TranscriptionPanel" Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="False"><ProgressBar IsIndeterminate="True" Width="90" Height="8" VerticalAlignment="Center"/><TextBlock x:Name="TranscriptionText" Text="Preparando transcripción…" Foreground="#D7DBE2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button x:Name="CancelTranscriptionButton" Content="Cancelar" Click="CancelTranscription_Click"/></StackPanel><StackPanel x:Name="IdlePanel" Grid.Row="1" Spacing="5" IsVisible="False"><TextBlock x:Name="IdleSessionText" Text="Selecciona una sesión" Foreground="#AAB1BD" TextTrimming="CharacterEllipsis"/><Grid ColumnDefinitions="Auto,*,Auto"><TextBlock x:Name="PlaybackCurrentText" Text="00:00" Foreground="#AAB1BD" FontSize="10" VerticalAlignment="Center"/><Slider x:Name="PlaybackSeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="PlaybackSeekSlider_ValueChanged"/><TextBlock x:Name="PlaybackDurationText" Grid.Column="2" Text="00:00" Foreground="#AAB1BD" FontSize="10" VerticalAlignment="Center"/></Grid><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock x:Name="PlaybackTrackText" Text="Sin reproducción" Foreground="#8A92A0" FontSize="10" VerticalAlignment="Center"/><Button x:Name="PlayMicrophoneButton" Content="▶ YO" Click="PlayMicrophone_Click"/><Button x:Name="PlayClientButton" Content="▶ CLIENTE" Click="PlayClient_Click"/><Button x:Name="StopPlaybackButton" Content="■" Click="StopPlayback_Click"/></StackPanel></StackPanel><Grid Grid.Row="2" ColumnDefinitions="*,Auto" x:Name="RecordingControls"><TextBlock Text="🔒 AES-256-GCM" Foreground="#8A92A0" FontSize="10" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5"><Button x:Name="PauseButton" Content="Ⅱ Pausar" Click="Pause_Click"/><Button x:Name="StopButton" Content="■ Detener" Click="Stop_Click"/></StackPanel></Grid></Grid></Border></Window>