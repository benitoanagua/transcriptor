<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Transcriptor.Tools</AssemblyName>
    <RootNamespace>Transcriptor.Tools</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.Diagnostics" />
    <Using Include="System.IO.Compression" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.RegularExpressions" />
    <ProjectReference Include="../Transcriptor.DesignData/Transcriptor.DesignData.csproj" />
  </ItemGroup>
</Project>
