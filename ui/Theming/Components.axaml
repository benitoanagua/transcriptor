<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource source-sans-3-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200x75-thickness}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-100}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="Border.spectrumNavigation">
    <Setter Property="Background" Value="{DynamicResource background-elevated-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-bottom-1-thickness}"/>
  </Style>
  <Style Selector="Button.spectrumTab">
    <Setter Property="Height" Value="{DynamicResource component-height-100}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100x50-thickness}"/>
    <Setter Property="FontFamily" Value="{DynamicResource source-sans-3-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="FontWeight" Value="{DynamicResource medium-font-weight}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-700}"/>
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-bottom-focus-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-0}"/>
  </Style>
  <Style Selector="Button.spectrumTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource gray-100}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-900}"/>
  </Style>
  <Style Selector="Button.spectrumTab.active">
    <Setter Property="Foreground" Value="{DynamicResource gray-900}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Border.spectrumSubheader">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-bottom-1-thickness}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="{DynamicResource opacity-disabled}"/>
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource accent-subtle-background-color-default}"/>
    <Setter Property="Foreground" Value="{DynamicResource accent-content-color-default}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource notice-color-1000}"/>
  </Style>
  <Style Selector="Button.windowAction">
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Height" Value="{DynamicResource component-height-200}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-200}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-700}"/>
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-0}"/>
  </Style>
  <Style Selector="Button.windowAction.minimize, Button.windowAction.close">
    <Setter Property="Width" Value="{DynamicResource component-height-200}"/>
  </Style>
  <Style Selector="Button.windowAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource transparent-white-100}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-1000}"/>
  </Style>
  <Style Selector="Button.windowAction.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource negative-background-color-default}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-1000}"/>
  </Style>
  <Style Selector="Border.captureCard">
    <Setter Property="Background" Value="{DynamicResource background-layer-2-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200-thickness}"/>
  </Style>
  <Style Selector="Border.captureHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-bottom-1-thickness}"/>
    <Setter Property="Padding" Value="{DynamicResource padding-bottom-spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.captureStateDot">
    <Setter Property="Width" Value="{DynamicResource status-light-dot-size-medium}"/>
    <Setter Property="Height" Value="{DynamicResource status-light-dot-size-medium}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-500}"/>
    <Setter Property="Background" Value="{DynamicResource positive-background-color-default}"/>
  </Style>
  <Style Selector="Border.captureStateDot.recording">
    <Setter Property="Background" Value="{DynamicResource negative-background-color-default}"/>
  </Style>
  <Style Selector="TextBlock.captureState">
    <Setter Property="Foreground" Value="{DynamicResource gray-700}"/>
    <Setter Property="FontFamily" Value="{DynamicResource code-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="FontWeight" Value="{DynamicResource medium-font-weight}"/>
  </Style>
  <Style Selector="TextBlock.captureState.recording">
    <Setter Property="Foreground" Value="{DynamicResource gray-900}"/>
  </Style>
  <Style Selector="TextBlock.captureAvailable">
    <Setter Property="Foreground" Value="{DynamicResource gray-700}"/>
    <Setter Property="FontFamily" Value="{DynamicResource code-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-50}"/>
  </Style>
  <Style Selector="TextBlock.captureAvailable.unavailable">
    <Setter Property="Foreground" Value="{DynamicResource gray-700}"/>
  </Style>
  <Style Selector="Button.transport">
    <Setter Property="Width" Value="{DynamicResource component-height-200}"/>
    <Setter Property="Height" Value="{DynamicResource component-height-200}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-200}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-500}"/>
  </Style>
  <Style Selector="Button.transport.record">
    <Setter Property="Width" Value="{DynamicResource component-height-400}"/>
    <Setter Property="Height" Value="{DynamicResource component-height-400}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-400}"/>
  </Style>
  <Style Selector="Button.captureAction">
    <Setter Property="MinHeight" Value="{DynamicResource component-height-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200x75-thickness}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-50}"/>
  </Style>
  <Style Selector="Border.captureTelemetry">
    <Setter Property="Background" Value="{DynamicResource background-elevated-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100x75-thickness}"/>
  </Style>
  <Style Selector="ListBox.sessionList">
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Margin" Value="{DynamicResource margin-bottom-spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.sessionCard">
    <Setter Property="Background" Value="{DynamicResource background-layer-2-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:pointerover Border.sessionCard">
    <Setter Property="BorderBrush" Value="{DynamicResource gray-500}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:selected Border.sessionCard">
    <Setter Property="Background" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:selected PathIcon.sessionIcon">
    <Setter Property="Foreground" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Border.sessionBadge">
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-85x50-thickness}"/>
  </Style>
  <Style Selector="Border.sessionBadge.success">
    <Setter Property="Background" Value="{DynamicResource positive-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource positive-background-color-default}"/>
  </Style>
  <Style Selector="Border.sessionBadge.warning">
    <Setter Property="Background" Value="{DynamicResource notice-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource notice-background-color-default}"/>
  </Style>
  <Style Selector="Border.sessionBadge.accent">
    <Setter Property="Background" Value="{DynamicResource accent-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Border.sessionBadge.muted">
    <Setter Property="Background" Value="{DynamicResource neutral-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
  </Style>
  <Style Selector="Button.sessionAction">
    <Setter Property="Width" Value="{DynamicResource component-height-75}"/>
    <Setter Property="Height" Value="{DynamicResource component-height-75}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-75}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptSegment">
    <Setter Property="Background" Value="{DynamicResource background-elevated-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptSegment:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Border.transcriptSegment.active">
    <Setter Property="Background" Value="{DynamicResource accent-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Border.transcriptSegment.match">
    <Setter Property="Background" Value="{DynamicResource notice-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource notice-background-color-default}"/>
  </Style>
  <Style Selector="ListBox.transcriptList">
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
  </Style>
  <Style Selector="ListBox.transcriptList ListBoxItem:selected Border.transcriptSegment">
    <Setter Property="Background" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Border.transcriptTime">
    <Setter Property="Background" Value="{DynamicResource background-base-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-200}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptText">
    <Setter Property="Background" Value="{DynamicResource background-base-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-200}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptHeader, Border.transcriptFooter, Border.libraryHeader, Border.libraryFooter">
    <Setter Property="Background" Value="{DynamicResource background-elevated-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
  </Style>
  <Style Selector="Border.transcriptHeader, Border.libraryHeader">
    <Setter Property="BorderThickness" Value="{DynamicResource border-bottom-1-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptFooter, Border.libraryFooter">
    <Setter Property="BorderThickness" Value="{DynamicResource border-left-1-thickness}"/>
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="FontWeight" Value="{DynamicResource medium-font-weight}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-700}"/>
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontFamily" Value="{DynamicResource code-font-family}"/>
  </Style>
  <Style Selector="Button.btn-bevel">
    <Setter Property="Background" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-900}"/>
  </Style>
  <Style Selector="Button.btn-bevel:pointerover">
    <Setter Property="Background" Value="{DynamicResource gray-300}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-500}"/>
  </Style>
  <Style Selector="Button.btn-bevel:pressed">
    <Setter Property="Background" Value="{DynamicResource background-elevated-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Button.record-active">
    <Setter Property="Background" Value="{DynamicResource negative-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource negative-background-color-default}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-1000}"/>
  </Style>
  <Style Selector="Button.btn-primary">
    <Setter Property="Background" Value="{DynamicResource accent-background-color-default}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-1000}"/>
    <Setter Property="FontWeight" Value="{DynamicResource bold-font-weight}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-300x75-thickness}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
  </Style>
  <Style Selector="Button.btn-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource accent-background-color-hover}"/>
  </Style>
  <Style Selector="Button.btn-secondary">
    <Setter Property="Background" Value="{DynamicResource gray-100}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-900}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200x75-thickness}"/>
  </Style>
  <Style Selector="Button.btn-icon">
    <Setter Property="Width" Value="{DynamicResource component-height-75}"/>
    <Setter Property="Height" Value="{DynamicResource component-height-75}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-75}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-700}"/>
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
  </Style>
  <Style Selector="Button:focus, TextBox:focus, ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource background-layer-2-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="Border.led-screen">
    <Setter Property="Background" Value="{DynamicResource background-base-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-200}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="Border.badge-ok">
    <Setter Property="Background" Value="{DynamicResource positive-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource positive-background-color-default}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="Border.badge-warn">
    <Setter Property="Background" Value="{DynamicResource notice-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource notice-background-color-default}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="Border.badge-neutral">
    <Setter Property="Background" Value="{DynamicResource neutral-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-500}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="Border.badge-accent">
    <Setter Property="Background" Value="{DynamicResource accent-subtle-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource source-sans-3-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-50}"/>
    <Setter Property="Background" Value="{DynamicResource gray-75}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100x50-thickness}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-75}"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource source-sans-3-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="Background" Value="{DynamicResource gray-75}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-600}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100x50-thickness}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-100}"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource source-sans-3-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-50}"/>
    <Setter Property="Foreground" Value="{DynamicResource gray-900}"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="{DynamicResource spacing-85}"/>
    <Setter Property="MinWidth" Value="{DynamicResource spacing-85}"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="{DynamicResource spacing-85}"/>
    <Setter Property="MinHeight" Value="{DynamicResource spacing-85}"/>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="{DynamicResource spacing-100}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Background" Value="{DynamicResource background-base-color}"/>
  </Style>
</Styles>
