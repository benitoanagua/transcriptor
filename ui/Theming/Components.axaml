<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource LabelSize}"/>
    <Setter Property="Padding" Value="{DynamicResource ButtonPadding}"/>
    <Setter Property="MinHeight" Value="{DynamicResource ButtonHeight}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  </Style>
  <Style Selector="Border.spectrumNavigation">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource TitleBarBorderThickness}"/>
  </Style>
  <Style Selector="Button.spectrumTab">
    <Setter Property="Height" Value="{DynamicResource TitleTabHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource TitleTabHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource TitleTabPadding}"/>
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource LabelSize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,0,0,2"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Button.spectrumTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.spectrumTab.active">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Border.spectrumSubheader">
    <Setter Property="Background" Value="{DynamicResource TitleBarBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource TitleBarBorderThickness}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentGlyph}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource WarningGlyph}"/>
  </Style>
  <Style Selector="Button.windowAction">
    <Setter Property="Padding" Value="{DynamicResource WindowButtonPadding}"/>
    <Setter Property="Height" Value="{DynamicResource WindowButtonHeight}"/>
    <Setter Property="MinHeight" Value="{DynamicResource WindowButtonHeight}"/>
    <Setter Property="FontSize" Value="{DynamicResource LabelSize}"/>
    <Setter Property="Foreground" Value="{DynamicResource TitleBarMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="Button.windowAction.minimize, Button.windowAction.close">
    <Setter Property="Width" Value="{DynamicResource WindowActionButtonWidth}"/>
  </Style>
  <Style Selector="Button.windowAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource WindowButtonHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
  </Style>
  <Style Selector="Button.windowAction.close:pointerover">
    <Setter Property="Background" Value="{DynamicResource Danger}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
  </Style>
  <Style Selector="Border.captureCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <Setter Property="Padding" Value="{DynamicResource CaptureCardPadding}"/>
  </Style>
  <Style Selector="Border.captureHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource CaptureHeaderBorderThickness}"/>
    <Setter Property="Padding" Value="{DynamicResource CaptureHeaderPadding}"/>
  </Style>
  <Style Selector="Border.captureStateDot">
    <Setter Property="Width" Value="{DynamicResource CaptureDotSize}"/>
    <Setter Property="Height" Value="{DynamicResource CaptureDotSize}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
    <Setter Property="Background" Value="{DynamicResource SuccessDot}"/>
  </Style>
  <Style Selector="Border.captureStateDot.recording">
    <Setter Property="Background" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="TextBlock.captureState">
    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource LabelSize}"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="TextBlock.captureState.recording">
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="TextBlock.captureAvailable">
    <Setter Property="Foreground" Value="{DynamicResource Success}"/>
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
  </Style>
  <Style Selector="TextBlock.captureAvailable.unavailable">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
  </Style>
  <Style Selector="Button.transport">
    <Setter Property="Width" Value="{DynamicResource TransportButtonSize}"/>
    <Setter Property="Height" Value="{DynamicResource TransportButtonSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource TransportButtonSize}"/>
    <Setter Property="Padding" Value="{DynamicResource WindowButtonPadding}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}"/>
  </Style>
  <Style Selector="Button.transport.record">
    <Setter Property="Width" Value="{DynamicResource RecordButtonSize}"/>
    <Setter Property="Height" Value="{DynamicResource RecordButtonSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource RecordButtonSize}"/>
  </Style>
  <Style Selector="Button.captureAction">
    <Setter Property="MinHeight" Value="{DynamicResource CaptureActionHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource CompactButtonPadding}"/>
    <Setter Property="FontSize" Value="{DynamicResource CaptionSize}"/>
  </Style>
  <Style Selector="Border.captureTelemetry">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Padding" Value="{DynamicResource TelemetryCellPadding}"/>
  </Style>
  <Style Selector="ListBox.sessionList">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="{DynamicResource SessionListPadding}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="Border.sessionCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceItem}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <Setter Property="Padding" Value="{DynamicResource SessionCardPadding}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:pointerover Border.sessionCard">
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeHover}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:selected Border.sessionCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:selected PathIcon.sessionIcon">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Border.sessionBadge">
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Padding" Value="{DynamicResource SessionBadgePadding}"/>
  </Style>
  <Style Selector="Border.sessionBadge.success">
    <Setter Property="Background" Value="{DynamicResource PillOk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeOkStroke}"/>
  </Style>
  <Style Selector="Border.sessionBadge.warning">
    <Setter Property="Background" Value="{DynamicResource PillWarn}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarnStroke}"/>
  </Style>
  <Style Selector="Border.sessionBadge.accent">
    <Setter Property="Background" Value="{DynamicResource PillAccent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeAccentStroke}"/>
  </Style>
  <Style Selector="Border.sessionBadge.muted">
    <Setter Property="Background" Value="{DynamicResource PillMuted}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
  </Style>
  <Style Selector="Button.sessionAction">
    <Setter Property="Width" Value="{DynamicResource SessionActionSize}"/>
    <Setter Property="Height" Value="{DynamicResource SessionActionSize}"/>
    <Setter Property="MinHeight" Value="{DynamicResource SessionActionSize}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Border.transcriptSegment">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
    <Setter Property="Padding" Value="{DynamicResource TranscriptSegmentPadding}"/>
  </Style>
  <Style Selector="Border.transcriptSegment:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Border.transcriptSegment.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Border.transcriptSegment.match">
    <Setter Property="Background" Value="{DynamicResource WarningSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource WarningStroke}"/>
  </Style>
  <Style Selector="ListBox.transcriptList">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.transcriptList ListBoxItem:selected Border.transcriptSegment">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Border.transcriptTime">
    <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Padding" Value="{DynamicResource TranscriptTimePadding}"/>
  </Style>
  <Style Selector="Border.transcriptText">
    <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Padding" Value="{DynamicResource TranscriptTextPadding}"/>
  </Style>
  <Style Selector="Border.transcriptHeader, Border.transcriptFooter, Border.libraryHeader, Border.libraryFooter">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
  </Style>
  <Style Selector="Border.transcriptHeader, Border.libraryHeader">
    <Setter Property="BorderThickness" Value="{DynamicResource TitleBarBorderThickness}"/>
  </Style>
  <Style Selector="Border.transcriptFooter, Border.libraryFooter">
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource LabelSize}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
  </Style>
  <Style Selector="Button.btn-bevel">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="Button.btn-bevel:pointerover">
    <Setter Property="Background" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeHover}"/>
  </Style>
  <Style Selector="Button.btn-bevel:pressed">
    <Setter Property="Background" Value="{DynamicResource Surface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Button.record-active">
    <Setter Property="Background" Value="{DynamicResource Danger}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
  </Style>
  <Style Selector="Button.btn-primary">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextStrong}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="{DynamicResource PrimaryButtonPadding}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.btn-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
  </Style>
  <Style Selector="Button.btn-secondary">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="{DynamicResource CompactButtonPadding}"/>
  </Style>
  <Style Selector="Button.btn-icon">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button:focus, TextBox:focus, ComboBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}"/>
  </Style>
  <Style Selector="Border.led-screen">
    <Setter Property="Background" Value="{DynamicResource LedScreen}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSubtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLed}"/>
  </Style>
  <Style Selector="Border.badge-ok">
    <Setter Property="Background" Value="{DynamicResource BadgeOkBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeOkStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  </Style>
  <Style Selector="Border.badge-warn">
    <Setter Property="Background" Value="{DynamicResource BadgeWarnBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarnStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  </Style>
  <Style Selector="Border.badge-neutral">
    <Setter Property="Background" Value="{DynamicResource BadgeNeutralBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeNeutralStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  </Style>
  <Style Selector="Border.badge-accent">
    <Setter Property="Background" Value="{DynamicResource BadgeAccentBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BadgeAccentStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="MinHeight" Value="24"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="MinHeight" Value="28"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="{DynamicResource ScrollBarThickness}"/>
    <Setter Property="MinWidth" Value="{DynamicResource ScrollBarThickness}"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="{DynamicResource ScrollBarThickness}"/>
    <Setter Property="MinHeight" Value="{DynamicResource ScrollBarThickness}"/>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusControl}"/>
    <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
  </Style>
</Styles>
