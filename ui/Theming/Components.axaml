<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.spectrumSubheader">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-bottom-1-thickness}"/>
  </Style>
  <!-- Pestañas dentro de la barra de título (cromo Stitch): sin la línea propia del TabControl y con más aire lateral. -->
  <Style Selector="TabControl.titleTabs /template/ Border">
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
  </Style>
  <Style Selector="TabControl.titleTabs TabItem">
    <Setter Property="Padding" Value="{DynamicResource spacing-200x50-thickness}"/>
  </Style>
  <!-- Tarjeta Stitch: capa 2, borde de 1 px y radio de 6 px, sin sombra. -->
  <Style Selector="Border.settingsCard">
    <Setter Property="Background" Value="{DynamicResource background-layer-2-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-width-100-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-300}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-300-thickness}"/>
  </Style>
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-width-100-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200-thickness}"/>
  </Style>
  <Style Selector="Border.consentCard">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-width-100-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-300}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.logPanel">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-width-100-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-300}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
  </Style>
  <Style Selector="TextBlock.timecode">
    <Setter Property="FontFamily" Value="{DynamicResource code-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-900}"/>
    <Setter Property="FontWeight" Value="{DynamicResource medium-font-weight}"/>
    <Setter Property="Foreground" Value="{DynamicResource heading-color}"/>
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontFamily" Value="{DynamicResource source-sans-3-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-400}"/>
    <Setter Property="FontWeight" Value="{DynamicResource bold-font-weight}"/>
    <Setter Property="Foreground" Value="{DynamicResource heading-color}"/>
  </Style>
  <!-- Button:disabled se hereda del tema Spectrum.Button (opacity-disabled). -->
  <!-- Los iconos dentro de un botón toman el Foreground del botón (el de su clase: accent,
       negative, outline…) en vez de un gris fijo; así el icono y la etiqueta siempre coinciden.
       Un PathIcon con Foreground local (cromo de ventana, estados) conserva el suyo. -->
  <Style Selector=":is(Button) PathIcon">
    <Setter Property="Foreground"
            Value="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Button}}, FallbackValue={DynamicResource icon-color-primary-default}}"/>
  </Style>
  <Style Selector="Border.captureCard">
    <Setter Property="Background" Value="{DynamicResource background-layer-2-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-width-100-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-300}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200-thickness}"/>
  </Style>
  <Style Selector="Border.captureHeader">
    <Setter Property="Padding" Value="{DynamicResource padding-bottom-spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.captureStateDot">
    <Setter Property="Width" Value="{DynamicResource status-light-dot-size-medium}"/>
    <Setter Property="Height" Value="{DynamicResource status-light-dot-size-medium}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-500}"/>
    <Setter Property="Background" Value="{DynamicResource positive-background-color-default}"/>
  </Style>
  <Style Selector="Border.captureStateDot.recording">
    <Setter Property="Background" Value="{DynamicResource negative-background-color-default}"/>
  </Style>
  <Style Selector="TextBlock.captureState">
    <Setter Property="Foreground" Value="{DynamicResource neutral-subdued-content-color-default}"/>
    <Setter Property="FontFamily" Value="{DynamicResource source-sans-3-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="FontWeight" Value="{DynamicResource semi-bold-font-weight}"/>
  </Style>
  <Style Selector="TextBlock.captureState.recording">
    <Setter Property="Foreground" Value="{DynamicResource heading-color}"/>
  </Style>
  <Style Selector="TextBlock.captureAvailable">
    <Setter Property="Foreground" Value="{DynamicResource neutral-subdued-content-color-default}"/>
    <Setter Property="FontFamily" Value="{DynamicResource code-font-family}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-50}"/>
  </Style>
  <Style Selector="TextBlock.captureAvailable.unavailable">
    <Setter Property="Foreground" Value="{DynamicResource neutral-subdued-content-color-default}"/>
  </Style>
  <!-- Jerarquía del transporte: Grabar (principal, rojo, ancho completo) > Pausar/Detener (secundarias) > Transcribir (contorno). -->
  <Style Selector="Button.transport">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Height" Value="{DynamicResource component-height-200}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-200}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200x75-thickness}"/>
  </Style>
  <Style Selector="ToggleButton.record">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Height" Value="{DynamicResource component-height-300}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-300}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-200}"/>
    <Setter Property="FontWeight" Value="{DynamicResource semi-bold-font-weight}"/>
    <Setter Property="Background" Value="{DynamicResource negative-background-color-default}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource negative-background-color-default}"/>
    <Setter Property="Foreground" Value="{DynamicResource static-white-text-color}"/>
  </Style>
  <Style Selector="ToggleButton.record:pointerover">
    <Setter Property="Background" Value="{DynamicResource negative-background-color-hover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource negative-background-color-hover}"/>
  </Style>
  <Style Selector="ToggleButton.record:pressed">
    <Setter Property="Background" Value="{DynamicResource negative-background-color-down}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource negative-background-color-down}"/>
  </Style>
  <Style Selector="Button.captureAction">
    <Setter Property="MinHeight" Value="{DynamicResource component-height-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200x75-thickness}"/>
    <Setter Property="FontSize" Value="{DynamicResource font-size-50}"/>
  </Style>
  <Style Selector="Border.captureTelemetry">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100x75-thickness}"/>
  </Style>
  <Style Selector="ListBox.sessionList">
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Margin" Value="{DynamicResource margin-bottom-spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.sessionCard">
    <Setter Property="Background" Value="{DynamicResource background-layer-2-color}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
    <Setter Property="Margin" Value="{DynamicResource margin-bottom-spacing-100-thickness}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:pointerover Border.sessionCard">
    <Setter Property="Background" Value="{DynamicResource neutral-subtle-background-color-default}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:selected Border.sessionCard">
    <Setter Property="Background" Value="{DynamicResource card-background-well-color}"/>
  </Style>
  <Style Selector="ListBox.sessionList ListBoxItem:selected PathIcon.sessionIcon">
    <Setter Property="Foreground" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Button.sessionAction">
    <Setter Property="MinWidth" Value="{DynamicResource component-height-75}"/>
    <Setter Property="MinHeight" Value="{DynamicResource component-height-75}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100x75-thickness}"/>
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptSegment">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-200-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptSegment:pointerover">
    <Setter Property="Background" Value="{DynamicResource neutral-subtle-background-color-default}"/>
  </Style>
  <Style Selector="Border.transcriptSegment.active">
    <Setter Property="Background" Value="{DynamicResource accent-subtle-background-color-default}"/>
  </Style>
  <Style Selector="Border.transcriptSegment.match">
    <Setter Property="Background" Value="{DynamicResource notice-subtle-background-color-default}"/>
  </Style>
  <Style Selector="ListBox.transcriptList">
    <Setter Property="Background" Value="{DynamicResource transparent-white-25}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-0-thickness}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-0-thickness}"/>
  </Style>
  <Style Selector="ListBox.transcriptList ListBoxItem:selected Border.transcriptSegment">
    <Setter Property="Background" Value="{DynamicResource card-background-well-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource accent-background-color-default}"/>
  </Style>
  <Style Selector="Border.transcriptTime">
    <Setter Property="Background" Value="{DynamicResource background-base-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-200}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptText">
    <Setter Property="Background" Value="{DynamicResource background-base-color}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource gray-200}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource spacing-25-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
    <Setter Property="Padding" Value="{DynamicResource spacing-100-thickness}"/>
  </Style>
  <Style Selector="Border.transcriptHeader, Border.transcriptFooter, Border.libraryHeader, Border.libraryFooter">
    <Setter Property="Background" Value="{DynamicResource background-layer-1-color}"/>
  </Style>
  <Style Selector="Border.libraryHeader">
    <Setter Property="BorderBrush" Value="{DynamicResource gray-100}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource border-width-100-thickness}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-300}"/>
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="{DynamicResource font-size-75}"/>
    <Setter Property="FontWeight" Value="{DynamicResource semi-bold-font-weight}"/>
    <Setter Property="Foreground" Value="{DynamicResource neutral-subdued-content-color-default}"/>
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontFamily" Value="{DynamicResource code-font-family}"/>
  </Style>
  <!-- Lista de sesiones de la Biblioteca: tope normal con una sesión seleccionada; sin selección el
       panel de detalle se colapsa y la lista crece hasta el tope ampliado. -->
  <Style Selector=".libraryList" x:SetterTargetType="Control">
    <Setter Property="MaxHeight" Value="{DynamicResource list-view-max-height}"/>
  </Style>
  <Style Selector=".libraryList.browsing" x:SetterTargetType="Control">
    <Setter Property="MaxHeight" Value="{DynamicResource list-view-max-height-expanded}"/>
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource background-layer-2-color}"/>
    <Setter Property="CornerRadius" Value="{DynamicResource corner-radius-100}"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="{DynamicResource spacing-85}"/>
    <Setter Property="MinWidth" Value="{DynamicResource spacing-85}"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="{DynamicResource spacing-85}"/>
    <Setter Property="MinHeight" Value="{DynamicResource spacing-85}"/>
  </Style>
</Styles>
