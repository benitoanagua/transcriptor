<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tr="using:Transcriptor.Transcription" x:Class="Transcriptor.UI.MainWindow" Title="Transcriptor" WindowDecorations="None" Width="900" Height="760" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#14161A">
<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="12" RowSpacing="8">
<Border Grid.Row="0" Background="#1C1F25" BorderBrush="#343943" BorderThickness="1" CornerRadius="5" Padding="10,6"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12"><StackPanel VerticalAlignment="Center" Spacing="2" PointerPressed="TitleBar_PointerPressed"><TextBlock Text="TRANSCRIPTOR" FontSize="13" FontWeight="Bold" Foreground="#D7DBE2"/><TextBlock Text="CAPTURA LOCAL · DOBLE PISTA" FontSize="9" Foreground="#8A92A0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"><Button Content="BIBLIOTECA" FontSize="9" Click="ToggleLibraryPanel_Click"/><Button Content="DISPOSITIVOS" FontSize="9" Click="ToggleDevicesPanel_Click"/><Button Content="AJUSTES" FontSize="9" Click="ToggleSettingsPanel_Click"/><Button Content="REGISTRO" FontSize="9" Click="ToggleLogPanel_Click"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"><Button Content="—" Width="34" Click="MinimizeWindow_Click"/><Button Content="□" Width="34" Click="MaximizeWindow_Click"/><Button Content="×" Width="34" Click="CloseWindow_Click"/></StackPanel></Grid></Border>
<Border Grid.Row="1" x:Name="DevelopmentBanner" IsVisible="False" Background="#3D1F14" BorderBrush="#B4643F" BorderThickness="1" CornerRadius="4" Padding="12,6"><TextBlock Text="MODO DESARROLLO — sin cifrado real ni captura de audio" Foreground="#F5B99A" FontSize="11" FontWeight="SemiBold"/></Border>
<Border Grid.Row="2" Background="#101D1A" BorderBrush="#343943" BorderThickness="1" CornerRadius="4" Padding="12,8"><Grid ColumnDefinitions="Auto,14,*"><StackPanel><TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="28" FontWeight="Bold" Foreground="#A8F0C2"/><TextBlock x:Name="StatusText" Text="LISTO" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#A8F0C2"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8"><Grid ColumnDefinitions="30,*,60"><TextBlock Text="MIC" Foreground="#8A92A0"/><ProgressBar x:Name="MicLevel" Grid.Column="1" Maximum="100" Height="8"/><TextBlock x:Name="MicLevelText" Grid.Column="2" Text="En espera" FontSize="9" Foreground="#8A92A0"/></Grid><Grid ColumnDefinitions="30,*,60"><TextBlock Text="SYS" Foreground="#8A92A0"/><ProgressBar x:Name="SystemLevel" Grid.Column="1" Maximum="100" Height="8"/><TextBlock x:Name="SystemLevelText" Grid.Column="2" Text="En espera" FontSize="9" Foreground="#8A92A0"/></Grid></StackPanel></Grid></Border>
<Grid Grid.Row="3" ColumnDefinitions="Auto,*"><TextBlock Text="REF" VerticalAlignment="Center" Margin="4,0,10,0" Foreground="#8A92A0"/><TextBox x:Name="ReferenceBox" Grid.Column="1" Text="Llamada"/></Grid>
<CheckBox Grid.Row="4" x:Name="ConsentCheckBox" Content="Tengo autorización para grabar y conservar el audio de todas las personas involucradas" Foreground="#D7DBE2" FontSize="10"/>
<StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6"><Button x:Name="StartButton" Content="● GRABAR" MinWidth="94" Click="StartRecording_Click"/><Button x:Name="PauseButton" Content="Ⅱ PAUSAR" MinWidth="94" IsEnabled="False" Click="PauseRecording_Click"/><Button x:Name="StopButton" Content="■ DETENER" MinWidth="94" IsEnabled="False" Click="StopRecording_Click"/></StackPanel>
<TabControl x:Name="WorkspaceTabs" Grid.Row="6">
<TabItem x:Name="LibraryTab" Header="BIBLIOTECA"><Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8" RowSpacing="7"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox x:Name="LibrarySearchBox" PlaceholderText="Buscar por fecha o referencia…" TextChanged="LibrarySearch_TextChanged"/><Button x:Name="RefreshLibraryButton" Grid.Column="1" Content="Actualizar" Click="RefreshLibrary_Click"/></Grid>
<ComboBox Grid.Row="1" x:Name="LibraryFilterBox" SelectedIndex="0" SelectionChanged="LibraryFilter_SelectionChanged"><ComboBoxItem Content="Todas las sesiones"/><ComboBoxItem Content="Dos pistas disponibles"/><ComboBoxItem Content="Solo micrófono"/><ComboBoxItem Content="Solo audio del sistema"/><ComboBoxItem Content="Con transcripción"/><ComboBoxItem Content="Captura incompleta"/></ComboBox>
<Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="8"><ListBox x:Name="LibraryList" SelectionChanged="LibraryList_SelectionChanged"/><Border Grid.Column="1" Background="#1C1F25" BorderBrush="#343943" BorderThickness="1" CornerRadius="4" Padding="10"><StackPanel Spacing="7"><TextBlock Text="DETALLES DE SESIÓN" FontSize="10" FontWeight="Bold" Foreground="#8A92A0"/><TextBlock x:Name="LibraryDetailsTitle" Text="Selecciona una sesión" FontWeight="Bold" Foreground="#D7DBE2" TextWrapping="Wrap"/><TextBlock x:Name="LibraryDetailsText" Text="Selecciona una sesión para ver las pistas reconocidas." Foreground="#AAB1BD" TextWrapping="Wrap" FontSize="11"/>
<StackPanel Spacing="5">
<TextBlock Text="REPRODUCCIÓN" FontSize="10" FontWeight="Bold" Foreground="#8A92A0"/>
<StackPanel Orientation="Horizontal" Spacing="5">
<Button Content="▶ MIC" Click="PlayMicrophone_Click"/>
<Button Content="▶ SISTEMA" Click="PlaySystem_Click"/>
<Button Content="■ DETENER" Click="StopPlayback_Click"/>
</StackPanel>
<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
<TextBlock x:Name="PlaybackCurrentTimeText" Text="00:00" Foreground="#AAB1BD" VerticalAlignment="Center"/>
<Slider x:Name="PlaybackSeekSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False" ValueChanged="PlaybackSeekSlider_ValueChanged"/>
<TextBlock x:Name="PlaybackDurationText" Grid.Column="2" Text="00:00" Foreground="#AAB1BD" VerticalAlignment="Center"/>
</Grid>
<TextBlock x:Name="PlaybackTrackText" Text="Selecciona una pista para reproducir" Foreground="#8A92A0" FontSize="10" TextWrapping="Wrap"/>
</StackPanel>

<TextBlock Text="TRANSCRIPCIÓN OFFLINE" FontSize="10" FontWeight="Bold" Foreground="#8A92A0"/>
<StackPanel Orientation="Horizontal" Spacing="5">
<Button x:Name="TranscribeButton" Content="TRANSCRIBIR PENDIENTES" Click="TranscribePending_Click"/>
<Button x:Name="CancelTranscriptionButton" Content="CANCELAR" IsEnabled="False" Click="CancelTranscription_Click"/>
</StackPanel>
<TextBlock x:Name="TranscriptionProgressText" Text="Configura Whisper en AJUSTES para transcribir" Foreground="#AAB1BD" FontSize="10" TextWrapping="Wrap"/>
<StackPanel Orientation="Horizontal" Spacing="5">
<Button x:Name="MigrateSessionButton" Content="MIGRAR A CIFRADO" Click="MigrateSession_Click"/>
<Button x:Name="DeleteSessionButton" Content="ELIMINAR SESIÓN" Click="DeleteSession_Click"/>
</StackPanel>
<StackPanel Orientation="Horizontal" Spacing="5">
<TextBlock Text="Retención (días; 0 desactiva)" VerticalAlignment="Center" Foreground="#AAB1BD" FontSize="10"/>
<TextBox x:Name="RetentionDaysBox" Width="58" Text="0"/>
<Button x:Name="ApplyRetentionButton" Content="APLICAR RETENCIÓN" Click="ApplyRetention_Click"/>
</StackPanel>
<TextBlock x:Name="LifecycleProgressText" Text="Migración y eliminación requieren confirmación." Foreground="#8A92A0" FontSize="10" TextWrapping="Wrap"/>
</StackPanel></Border></Grid>
<TextBlock Grid.Row="3" x:Name="LibraryCountText" Text="Biblioteca sin cargar" Foreground="#8A92A0" FontSize="10"/></Grid></TabItem>
<TabItem x:Name="DevicesTab" Header="DISPOSITIVOS"><StackPanel Margin="10" Spacing="8"><TextBlock Text="Micrófono" Foreground="#D7DBE2"/><ComboBox x:Name="MicrophoneDeviceBox"><ComboBox.ItemTemplate><DataTemplate x:DataType="tr:AudioDeviceOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="Salida de audio del sistema" Foreground="#D7DBE2"/><ComboBox x:Name="OutputDeviceBox"><ComboBox.ItemTemplate><DataTemplate x:DataType="tr:AudioDeviceOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="Actualizar dispositivos" HorizontalAlignment="Left" Click="RefreshDevices_Click"/><TextBlock Text="La captura usa dos pistas cifradas independientes. El consentimiento es obligatorio antes de iniciar." TextWrapping="Wrap" Foreground="#8A92A0"/></StackPanel></TabItem>
<TabItem x:Name="SettingsTab" Header="AJUSTES"><StackPanel Margin="10" Spacing="7"><TextBlock Text="Carpeta de grabaciones" Foreground="#D7DBE2"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox x:Name="RecordingsPathBox"/><Button Grid.Column="1" Content="Examinar…" Click="BrowseRecordingsPath_Click"/></Grid><TextBlock Text="Whisper CLI" Foreground="#D7DBE2"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox x:Name="WhisperExecutableBox"/><Button Grid.Column="1" Content="Examinar…" Click="BrowseWhisperExecutable_Click"/></Grid><TextBlock Text="Modelo Whisper" Foreground="#D7DBE2"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox x:Name="WhisperModelBox"/><Button Grid.Column="1" Content="Examinar…" Click="BrowseWhisperModel_Click"/></Grid><TextBlock Text="Tema" Foreground="#D7DBE2"/><ComboBox x:Name="ThemeModeBox" SelectedIndex="0"><ComboBoxItem Content="Sistema"/><ComboBoxItem Content="Claro"/><ComboBoxItem Content="Oscuro"/></ComboBox><TextBlock Text="Idioma" Foreground="#D7DBE2"/><TextBox x:Name="WhisperLanguageBox"/><TextBlock Text="Retención de sesiones (días; 0 = desactivada)" Foreground="#D7DBE2"/><TextBox x:Name="RetentionSettingsBox" Text="0"/><Button Content="Guardar ajustes" HorizontalAlignment="Left" Click="SaveSettings_Click"/></StackPanel></TabItem>
<TabItem x:Name="LogTab" Header="REGISTRO"><TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="8"/></TabItem>
</TabControl></Grid></Window>
