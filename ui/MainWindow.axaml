<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tr="using:Transcriptor.Transcription"
        xmlns:vm="using:Transcriptor.UI.ViewModels"
        xmlns:ui="using:Transcriptor.UI"
        x:Class="Transcriptor.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Transcriptor"
        Width="1120"
        Height="780"
        MinWidth="1000"
        MinHeight="680"
        ExtendClientAreaTitleBarHeightHint="{StaticResource TitleBarHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Transcriptor.UI/Theming/Tokens.axaml"/>
        <ResourceInclude Source="avares://Transcriptor.UI/Theming/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="avares://Transcriptor.UI/Theming/Components.axaml"/>
  </Window.Styles>

  <Grid x:Name="RootGrid" RowSpacing="{StaticResource Gap8}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border x:Name="TitleBar"
            Grid.Row="0"
              Height="{StaticResource TitleBarHeight}"
              Background="{DynamicResource TitleBarBackground}"
            BorderBrush="{DynamicResource Stroke}"
              BorderThickness="{StaticResource TitleBarBorderThickness}"
              Padding="{StaticResource TitleBarPadding}"
              PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource TitleBarSpacing}">
        <Border Width="{StaticResource TitleBarLogoSize}" Height="{StaticResource TitleBarLogoSize}"
                  Background="{DynamicResource PrimaryGradient}" CornerRadius="{DynamicResource RadiusControl}"
                  VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconMicrophone}" Width="{StaticResource TitleBarIconSize}"
                      Height="{StaticResource TitleBarIconSize}" Foreground="{DynamicResource TextStrong}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="1" Text="TRANSCRIPTOR" FontFamily="{DynamicResource MonoFont}"
                     FontSize="{DynamicResource LabelSize}" FontWeight="Bold" LetterSpacing="0.6"
                     Foreground="{DynamicResource TitleBarText}" VerticalAlignment="Center"/>
        <Border Grid.Column="2" Width="{StaticResource TitleBarDividerWidth}" Height="{StaticResource TitleBarDividerHeight}" Background="{DynamicResource StrokeStrong}"
                  VerticalAlignment="Center"/>
        <Border Grid.Column="3" Classes="titleTabs" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap0}">
            <Button x:Name="StudioTab" Classes="titleTab" Classes.active="{Binding IsStudioPage}"
                    Content="Estudio" Command="{Binding ShowRecordingPageCommand}"/>
            <Button x:Name="SettingsTab" Classes="titleTab" Classes.active="{Binding IsSettingsPage}"
                    Content="Ajustes" Command="{Binding ShowSettingsPageCommand}"/>
            <Button x:Name="LogTab" Classes="titleTab" Classes.active="{Binding IsLogPage}"
                    Content="Registro" Command="{Binding ShowLogPageCommand}"/>
          </StackPanel>
        </Border>
        <Grid Grid.Column="4" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Gap8}"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap4}" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconFolder}" Width="{StaticResource TitleBarIconSize}"
                        Height="{StaticResource TitleBarIconSize}" Foreground="{DynamicResource AccentAmber}"/>
              <TextBlock Text="Sesión:" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                         Foreground="{DynamicResource TitleBarMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding CurrentSessionPath}" FontFamily="{DynamicResource MonoFont}"
                       FontSize="{DynamicResource CaptionSize}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarText}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
        </Grid>
        <Border Grid.Column="5" Classes="badge-ok" Padding="{DynamicResource TitleBarBadgePadding}"
                  IsVisible="{Binding IsEncryptionAvailable}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap4}">
              <PathIcon Data="{StaticResource IconLock}" Width="{StaticResource TitleBarIconSize}"
                        Height="{StaticResource TitleBarIconSize}" Foreground="{DynamicResource BadgeOkForeground}"/>
              <TextBlock Text="CIFRADO AES-256" FontFamily="{DynamicResource MonoFont}"
                         FontSize="{DynamicResource CaptionSize}" Foreground="{DynamicResource BadgeOkForeground}"
                         VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ComboBox x:Name="ThemeSelector" Grid.Column="6" Width="{StaticResource ThemeSelectorWidth}"
                  Height="{DynamicResource ThemeSelectorHeight}"
                    SelectedIndex="{Binding Settings.ThemeModeIndex, Mode=TwoWay}"
                    ToolTip.Tip="Tema de la aplicación" AutomationProperties.Name="Tema de la aplicación"
                    VerticalAlignment="Center">
            <ComboBoxItem Content="Sistema"/>
            <ComboBoxItem Content="Claro"/>
            <ComboBoxItem Content="Oscuro"/>
        </ComboBox>
        <Border Grid.Column="7" Width="{StaticResource TitleBarDividerWidth}" Height="{StaticResource TitleBarDividerHeight}"
                  Background="{DynamicResource StrokeStrong}" VerticalAlignment="Center"/>
        <StackPanel x:Name="WindowButtons" Grid.Column="8" Orientation="Horizontal" Spacing="{StaticResource Gap0}" VerticalAlignment="Center">
            <Button x:Name="MinimizeButton" Classes="windowAction minimize" Content="—" Click="MinimizeWindow_Click"
                    ToolTip.Tip="Minimizar" AutomationProperties.Name="Minimizar ventana"/>
            <Button x:Name="MaximizeButton" Classes="windowAction maximize" Content="□" Click="MaximizeWindow_Click"
                    ToolTip.Tip="Maximizar o restaurar" AutomationProperties.Name="Maximizar o restaurar ventana"/>
            <Button x:Name="CloseButton" Classes="windowAction close" Content="×" Click="CloseWindow_Click"
                    ToolTip.Tip="Cerrar" AutomationProperties.Name="Cerrar ventana"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">
      <Border x:Name="DevelopmentBanner"
              Grid.Row="0"
              IsVisible="{Binding DevelopmentBannerVisible}"
              Background="{DynamicResource WarningSurface}"
              BorderBrush="{DynamicResource WarningStroke}"
              BorderThickness="1"
              CornerRadius="{DynamicResource RadiusControl}"
              Padding="12,7">
        <TextBlock Text="MODO DESARROLLO — sin cifrado real ni captura de audio"
                   Foreground="{DynamicResource WarningGlyph}" FontSize="12" FontWeight="SemiBold"/>
      </Border>

      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <Grid Grid.RowSpan="2" RowDefinitions="Auto,*">
          <Grid x:Name="CaptureGrid" Grid.Row="0" RowDefinitions="Auto"
                ColumnSpacing="{StaticResource CaptureColumnGap}" RowSpacing="{StaticResource CaptureRowGap}"
                SizeChanged="CaptureGrid_SizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CaptureCardA" Grid.Column="0" Grid.ColumnSpan="4" Classes="captureCard">
              <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="{StaticResource Gap8}">
                <Grid Classes="captureHeader" ColumnDefinitions="Auto,*,Auto">
                  <Border Classes="captureStateDot" Classes.recording="{Binding Recorder.IsRecordingActive}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Classes="captureState" Classes.recording="{Binding Recorder.IsRecordingActive}"
                             Text="{Binding Recorder.CaptureStatusLabel}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Recorder.ElapsedText}" FontFamily="{DynamicResource TimerFont}"
                             FontSize="{DynamicResource TimerSize}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="{StaticResource Gap8}">
                  <Button Classes="btn-bevel transport record" Classes.record-active="{Binding Recorder.IsRecordingActive}"
                          Command="{Binding Recorder.StartRecordingCommand}" IsEnabled="{Binding Recorder.CanStartRecording}"
                          ToolTip.Tip="Iniciar grabación · Ctrl+R" AutomationProperties.Name="Iniciar grabación">
                    <PathIcon Data="{StaticResource IconCircle}" Width="{StaticResource RecordIconSize}"
                              Height="{StaticResource RecordIconSize}" Foreground="{DynamicResource Danger}"/>
                  </Button>
                  <Button Classes="btn-bevel transport" Command="{Binding Recorder.PauseRecordingCommand}"
                          IsEnabled="{Binding Recorder.CanStopRecording}" ToolTip.Tip="Pausar o reanudar · Ctrl+P"
                          AutomationProperties.Name="{Binding Recorder.PauseLabel}">
                    <PathIcon Data="{StaticResource IconPause}" Width="{StaticResource TransportIconSize}"
                              Height="{StaticResource TransportIconSize}" Foreground="{DynamicResource TextPrimary}"/>
                  </Button>
                  <Button Classes="btn-bevel transport" Command="{Binding Recorder.StopRecordingCommand}"
                          IsEnabled="{Binding Recorder.CanStopRecording}" ToolTip.Tip="Detener y guardar ambas pistas"
                          AutomationProperties.Name="Detener grabación">
                    <PathIcon Data="{StaticResource IconStop}" Width="{StaticResource TransportIconSize}"
                              Height="{StaticResource TransportIconSize}" Foreground="{DynamicResource TextPrimary}"/>
                  </Button>
                  <Border Width="{StaticResource TitleBarDividerWidth}" Height="{StaticResource TransportDividerHeight}"
                          Background="{DynamicResource Stroke}" VerticalAlignment="Center"/>
                  <Button Classes="btn-primary" Command="{Binding Transcript.TranscribeSelectedCommand}"
                          IsEnabled="{Binding Transcript.CanTranscribeSelected}" ToolTip.Tip="Transcribir la sesión seleccionada">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap4}">
                      <PathIcon Data="{StaticResource IconWand}" Width="{StaticResource TitleBarIconSize}"
                                Height="{StaticResource TitleBarIconSize}" Foreground="{DynamicResource TextStrong}"/>
                      <TextBlock Text="TRANSCRIBIR" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="{StaticResource Gap4}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding WhisperStatusText}" FontFamily="{DynamicResource MonoFont}"
                               FontSize="{DynamicResource CaptionSize}" Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Transcript.TranscriptionProgressText}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                               Foreground="{DynamicResource AccentCyan}" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                  <ProgressBar IsIndeterminate="{Binding Transcript.IsTranscribing}"
                               IsVisible="{Binding Transcript.IsTranscribing}"/>
                </StackPanel>
                <Border Grid.Row="3" IsVisible="{Binding Recorder.HasCaptureFault}" Classes="badge-warn"
                        Padding="{DynamicResource CompactButtonPadding}">
                  <TextBlock Text="{Binding Recorder.CaptureFaultMessage}" Foreground="{DynamicResource WarningGlyph}"
                             TextWrapping="Wrap"/>
                </Border>
              </Grid>
            </Border>
            <Border x:Name="CaptureCardB" Grid.Column="4" Grid.ColumnSpan="5" Classes="captureCard">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource Gap8}">
                <Grid Classes="captureHeader" ColumnDefinitions="Auto,*,Auto,Auto">
                  <PathIcon Data="{StaticResource IconWaveform}" Width="{StaticResource TitleBarIconSize}"
                            Height="{StaticResource TitleBarIconSize}" Foreground="{DynamicResource AccentCyan}"
                            VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="CAPTURA DUAL" FontFamily="{DynamicResource MonoFont}"
                             FontSize="{DynamicResource CaptionSize}" Foreground="{DynamicResource TextMuted}"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Recorder.MicrophoneStatusText}" Classes="captureAvailable"
                             Classes.unavailable="{Binding !Recorder.HasMicrophone}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Recorder.LoopbackStatusText}" Classes="captureAvailable"
                             Classes.unavailable="{Binding !Recorder.IsSystemCaptureAvailable}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Gap8}">
                  <TextBlock Text="MIC" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                             FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Recorder.Microphones}"
                            SelectedItem="{Binding Recorder.SelectedMicrophone, Mode=TwoWay}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="tr:AudioDeviceOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Border Grid.Row="2" Classes="led-screen" Height="{StaticResource WaveformLaneHeight}">
                  <ui:WaveformView Levels="{Binding Recorder.MicrophoneWaveform}" Color="{DynamicResource Accent}"
                                  InactiveColor="{DynamicResource Stroke}" IsActive="{Binding Recorder.IsAudioActive}"
                                  AutomationProperties.Name="Nivel de la pista MIC"/>
                </Border>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="{StaticResource Gap8}">
                  <TextBlock Text="CLIPPING" Foreground="{DynamicResource WarningGlyph}" FontWeight="Bold"
                             IsVisible="{Binding Recorder.MicClipping}"/>
                  <TextBlock Text="SIN SEÑAL &gt;10 s" Foreground="{DynamicResource WarningGlyph}"
                             IsVisible="{Binding Recorder.MicSilenceWarning}"/>
                  <Button Classes="btn-bevel btn-secondary captureAction" Content="Reiniciar clipping"
                          Command="{Binding Recorder.ResetMicrophoneClippingCommand}"
                          IsVisible="{Binding Recorder.MicClipping}" ToolTip.Tip="Reiniciar el indicador de clipping del micrófono"/>
                </StackPanel>
                <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Gap8}">
                  <TextBlock Text="SISTEMA" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                             FontWeight="Bold" Foreground="{DynamicResource WaveformSystem}" VerticalAlignment="Center"/>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Recorder.Outputs}"
                            SelectedItem="{Binding Recorder.SelectedOutput, Mode=TwoWay}"
                            IsEnabled="{Binding Recorder.IsSystemLoopbackAvailable}">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="tr:AudioDeviceOption"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Border Grid.Row="5" Classes="led-screen" Height="{StaticResource WaveformLaneHeight}">
                  <Grid>
                    <ui:WaveformView Levels="{Binding Recorder.SystemWaveform}" Color="{DynamicResource WaveformSystem}"
                                    InactiveColor="{DynamicResource Stroke}" IsActive="{Binding Recorder.IsAudioActive}"
                                    IsVisible="{Binding Recorder.IsSystemCaptureAvailable}"
                                    AutomationProperties.Name="Nivel de la pista SISTEMA"/>
                    <TextBlock Text="{Binding Recorder.SystemUnavailableText}" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                               IsVisible="{Binding !Recorder.IsSystemCaptureAvailable}"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="{StaticResource Gap8}"
                            IsVisible="{Binding Recorder.IsSystemLoopbackAvailable}">
                  <TextBlock Text="CLIPPING" Foreground="{DynamicResource WarningGlyph}" FontWeight="Bold"
                             IsVisible="{Binding Recorder.SystemClipping}"/>
                  <TextBlock Text="SIN SEÑAL &gt;10 s" Foreground="{DynamicResource WarningGlyph}"
                             IsVisible="{Binding Recorder.SystemSilenceWarning}"/>
                  <Button Classes="btn-bevel btn-secondary captureAction" Content="Reiniciar clipping"
                          Command="{Binding Recorder.ResetSystemClippingCommand}"
                          IsVisible="{Binding Recorder.SystemClipping}" ToolTip.Tip="Reiniciar el indicador de clipping del sistema"/>
                </StackPanel>
                <Grid Grid.Row="7" ColumnDefinitions="*,*,*,*" ColumnSpacing="{StaticResource Gap4}">
                  <Border Classes="captureTelemetry" ToolTip.Tip="{Binding Recorder.MicNoiseFloorText}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="PEAK MIC" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                                 Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Recorder.MicPeakValueText}" FontFamily="{DynamicResource MonoFont}"
                                 FontSize="{DynamicResource CaptionSize}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Classes="captureTelemetry" ToolTip.Tip="{Binding Recorder.MicNoiseFloorText}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="RMS MIC" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                                 Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Recorder.MicRmsValueText}" FontFamily="{DynamicResource MonoFont}"
                                 FontSize="{DynamicResource CaptionSize}" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Classes="captureTelemetry" ToolTip.Tip="{Binding Recorder.SystemNoiseFloorText}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="PEAK SIS" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                                 Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Recorder.SystemPeakValueText}" FontFamily="{DynamicResource MonoFont}"
                                 FontSize="{DynamicResource CaptionSize}" FontWeight="Bold" Foreground="{DynamicResource Accent}"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="3" Classes="captureTelemetry" ToolTip.Tip="{Binding Recorder.SystemNoiseFloorText}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="RMS SIS" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                                 Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Recorder.SystemRmsValueText}" FontFamily="{DynamicResource MonoFont}"
                                 FontSize="{DynamicResource CaptionSize}" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <Border x:Name="CaptureCardC" Grid.Column="9" Grid.ColumnSpan="3" Classes="captureCard">
              <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="{StaticResource Gap8}">
                <Border Classes="captureHeader">
                  <TextBlock Text="SESIÓN" FontFamily="{DynamicResource MonoFont}"
                             FontSize="{DynamicResource LabelSize}" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimary}"/>
                </Border>
                <StackPanel Grid.Row="1" Spacing="{StaticResource Gap4}">
                  <TextBlock Text="Referencia" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource CaptionSize}"
                             Foreground="{DynamicResource TextMuted}"/>
                  <TextBox Height="{StaticResource ReferenceInputHeight}" Text="{Binding Recorder.ReferenceText}"
                           IsEnabled="{Binding !Recorder.IsRecordingActive}"/>
                </StackPanel>
                <CheckBox Grid.Row="2" Content="Tengo autorización para grabar y conservar el audio de todas las personas involucradas"
                          FontSize="{DynamicResource CaptionSize}" IsChecked="{Binding Recorder.ConsentGranted, Mode=TwoWay}"
                          IsEnabled="{Binding !Recorder.IsRecordingActive}"
                          AutomationProperties.Name="Confirmo autorización obligatoria para grabar"/>
                <StackPanel Grid.Row="3" Spacing="{StaticResource Gap8}">
                  <Button Classes="btn-bevel btn-secondary captureAction" Content="Actualizar dispositivos"
                          Command="{Binding Recorder.RefreshDevicesCommand}"
                          ToolTip.Tip="Volver a detectar los dispositivos de audio"/>
                  <Button Classes="btn-bevel btn-secondary captureAction" Content="Probar niveles"
                          Command="{Binding Recorder.StartLevelTestingCommand}"
                          IsEnabled="{Binding Recorder.CanStartLevelTesting}"
                          IsVisible="{Binding !Recorder.IsTestingLevels}"
                          ToolTip.Tip="Medir micrófono y sistema sin crear sesión ni guardar audio"/>
                  <Button Classes="btn-bevel btn-secondary captureAction" Content="Detener prueba"
                          Command="{Binding Recorder.StopLevelTestingCommand}"
                          IsEnabled="{Binding Recorder.CanStopLevelTesting}"
                          IsVisible="{Binding Recorder.IsTestingLevels}"
                          ToolTip.Tip="Detener la medición y liberar los dispositivos"/>
                </StackPanel>
                <TextBlock Grid.Row="4" Text="{Binding Recorder.LevelTestStatusText}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="{DynamicResource CaptionSize}" TextWrapping="Wrap"
                           IsVisible="{Binding Recorder.HasLevelTestStatus}"/>
              </Grid>
            </Border>
          </Grid>

          <Border Grid.Row="1" IsVisible="{Binding IsStudioPage}" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="LibrarySearchBox" Text="{Binding Library.LibrarySearchText, Mode=TwoWay}" PlaceholderText="Buscar por fecha o referencia…" ToolTip.Tip="Buscar en la biblioteca · Ctrl+F" AutomationProperties.Name="Buscar sesiones"/>
                <ComboBox Grid.Column="1" SelectedIndex="{Binding Library.LibraryFilterIndex, Mode=TwoWay}">
                  <ComboBoxItem Content="Todas"/>
                  <ComboBoxItem Content="Dos pistas"/>
                  <ComboBoxItem Content="Solo MIC"/>
                  <ComboBoxItem Content="Solo SISTEMA"/>
                  <ComboBoxItem Content="Con transcripción"/>
                  <ComboBoxItem Content="Incompletas"/>
                </ComboBox>
                <ComboBox Grid.Column="2" SelectedIndex="{Binding Library.SortModeIndex, Mode=TwoWay}" ToolTip.Tip="Orden de sesiones">
                  <ComboBoxItem Content="Fecha reciente"/>
                  <ComboBoxItem Content="Nombre"/>
                  <ComboBoxItem Content="Fecha antigua"/>
                </ComboBox>
                <Button Grid.Column="3" Content="Actualizar" Command="{Binding Library.RefreshLibraryCommand}" IsEnabled="{Binding Library.CanInteract}" ToolTip.Tip="Actualizar la biblioteca · F5"/>
                <Button Grid.Column="4" Content="{Binding LibraryPanelToggleLabel}" Command="{Binding ToggleLibraryPanelCommand}" ToolTip.Tip="Mostrar u ocultar el panel de biblioteca"/>
              </Grid>
              <Grid x:Name="LibraryGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4*"/>
                  <ColumnDefinition Width="8*"/>
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" ItemsSource="{Binding Library.FilteredRecordings}" SelectedItem="{Binding Library.SelectedRecording, Mode=TwoWay}" IsEnabled="{Binding Library.CanInteract}" AutomationProperties.Name="Sesiones de la biblioteca">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryEntry">
                      <StackPanel Spacing="5" Margin="4,6">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sizes}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillOk}" IsVisible="{Binding HasMicrophone}"><TextBlock Text="MIC ✓" FontSize="11" Foreground="{DynamicResource PillOkText}"/></Border>
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillMuted}" IsVisible="{Binding !HasMicrophone}"><TextBlock Text="MIC —" FontSize="11" Foreground="{DynamicResource TextSecondary}"/></Border>
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillOk}" IsVisible="{Binding HasClient}"><TextBlock Text="SISTEMA ✓" FontSize="11" Foreground="{DynamicResource PillOkText}"/></Border>
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillMuted}" IsVisible="{Binding !HasClient}"><TextBlock Text="SISTEMA —" FontSize="11" Foreground="{DynamicResource TextSecondary}"/></Border>
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillAccent}" IsVisible="{Binding HasTranscript}"><TextBlock Text="TRANSCRITA" FontSize="11" Foreground="{DynamicResource AccentGlyph}"/></Border>
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillWarn}" IsVisible="{Binding IsIncomplete}"><TextBlock Text="INCOMPLETA" FontSize="11" Foreground="{DynamicResource WarningGlyph}"/></Border>
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillMuted}" IsVisible="{Binding IsEncrypted}"><TextBlock Text="CIFRADA" FontSize="11" Foreground="{DynamicResource TextSecondary}"/></Border>
                          <Border CornerRadius="3" Padding="5,2" Background="{DynamicResource PillWarn}" IsVisible="{Binding !IsEncrypted}"><TextBlock Text="EN CLARO" FontSize="11" Foreground="{DynamicResource WarningGlyph}"/></Border>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="14">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="9">
                      <TextBlock Classes="h2" Text="DETALLE DE SESIÓN"/>
                      <TextBlock Text="{Binding Detail.LibraryDetailsTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail.LibraryDetailsText}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                      <TextBlock Classes="h2" Text="REPRODUCCIÓN"/>
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Content="▶ MIC" Command="{Binding Detail.PlayMicrophoneCommand}" ToolTip.Tip="Reproducir pista del micrófono"/>
                        <Button Content="▶ SISTEMA" Command="{Binding Detail.PlaySystemCommand}" ToolTip.Tip="Reproducir pista del sistema"/>
                        <Button Content="{Binding Detail.PlaybackToggleLabel}"
                                Command="{Binding Detail.TogglePlaybackCommand}" ToolTip.Tip="Pausar o reanudar reproducción · Espacio" AutomationProperties.Name="Pausar o reanudar reproducción"/>
                        <Button Content="■ DETENER" Command="{Binding Detail.StopPlaybackCommand}" ToolTip.Tip="Detener reproducción"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="▶ MEZCLA" IsEnabled="{Binding Detail.SupportsMixedAudioPlayback}"
                                ToolTip.Tip="Mezcla sincronizada no disponible en esta plataforma"
                                AutomationProperties.Name="Reproducir mezcla de micrófono y sistema"/>
                        <TextBlock Text="Mezcla sincronizada no disponible" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"
                                   IsVisible="{Binding !Detail.SupportsMixedAudioPlayback}"/>
                      </StackPanel>
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Detail.PlaybackCurrentTimeText}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Classes="metric"/>
                        <Slider Minimum="0" Maximum="{Binding Detail.SeekMaximum}" Value="{Binding Detail.SeekValue, Mode=TwoWay}" IsEnabled="{Binding Detail.SeekEnabled}" Grid.Column="1" ToolTip.Tip="Posición de reproducción" AutomationProperties.Name="Posición de reproducción"/>
                        <TextBlock Text="{Binding Detail.PlaybackDurationText}" Grid.Column="2" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Classes="metric"/>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Velocidad" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <ComboBox IsEnabled="{Binding Detail.SupportsVariablePlaybackRate}"
                                  SelectedIndex="1" MinWidth="110"
                                  ToolTip.Tip="La velocidad variable no está disponible en esta plataforma"
                                  AutomationProperties.Name="Velocidad de reproducción">
                          <ComboBoxItem Content="0,75×"/>
                          <ComboBoxItem Content="1×"/>
                          <ComboBoxItem Content="1,25×"/>
                          <ComboBoxItem Content="1,5×"/>
                          <ComboBoxItem Content="2×"/>
                        </ComboBox>
                        <TextBlock Text="Velocidad variable no disponible" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"
                                   IsVisible="{Binding !Detail.SupportsVariablePlaybackRate}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Detail.PlaybackTrackText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                      <TextBlock Classes="h2" Text="TRANSCRIPCIÓN"/>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                        <TextBox Text="{Binding Transcript.SearchText, Mode=TwoWay}" PlaceholderText="Buscar en la transcripción…"/>
                        <Button Grid.Column="1" Content="↑" Command="{Binding Transcript.PreviousMatchCommand}" ToolTip.Tip="Coincidencia anterior" AutomationProperties.Name="Coincidencia anterior"/>
                        <Button Grid.Column="2" Content="↓" Command="{Binding Transcript.NextMatchCommand}" ToolTip.Tip="Coincidencia siguiente" AutomationProperties.Name="Coincidencia siguiente"/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding Transcript.SearchCountText}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" Content="Seguimiento" IsChecked="{Binding Transcript.AutoScrollEnabled, Mode=TwoWay}" ToolTip.Tip="Desactiva el desplazamiento automático"/>
                        <Button Grid.Column="2" Content="Copiar segmentos" Command="{Binding Transcript.CopySelectedSegmentsCommand}"/>
                      </Grid>
                      <Border Background="{DynamicResource AppBackground}" CornerRadius="5" Padding="6" MinHeight="90">
                        <Grid>
                          <TextBlock Text="{Binding Transcript.TranscriptEmptyText}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !Transcript.HasVisibleSegments}"/>
                          <ListBox ItemsSource="{Binding Transcript.FilteredSegments}" SelectedItem="{Binding Transcript.SelectedSegment, Mode=TwoWay}"
                                   SelectionMode="Multiple" SelectionChanged="TranscriptSegments_SelectionChanged"
                                   IsVisible="{Binding Transcript.HasVisibleSegments}" MaxHeight="220" AutomationProperties.Name="Segmentos de la transcripción">
                            <ListBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:TranscriptSegmentViewModel">
                                <Grid Margin="2,3">
                                  <Border Background="{DynamicResource AccentSoft}" CornerRadius="3" IsVisible="{Binding IsActive}"/>
                                  <Border Background="{DynamicResource WarningSurface}" CornerRadius="3" IsVisible="{Binding IsMatch}"/>
                                  <StackPanel Margin="6,4" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Text="{Binding TimeRange}" Classes="metric" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                      <TextBlock Text="{Binding Segment.Speaker}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentGlyph}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Segment.Text}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ListBox.ItemTemplate>
                          </ListBox>
                        </Grid>
                      </Border>
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Content="TRANSCRIBIR ESTA SESIÓN" Classes="accent" Command="{Binding Transcript.TranscribeSelectedCommand}" IsEnabled="{Binding Transcript.CanTranscribeSelected}"/>
                        <Button Content="TRANSCRIBIR PENDIENTES" Command="{Binding Transcript.TranscribePendingCommand}" IsEnabled="{Binding Transcript.CanTranscribePending}"/>
                        <Button Content="CANCELAR" Command="{Binding Transcript.CancelTranscriptionCommand}" IsEnabled="{Binding Transcript.CanCancelTranscription}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Exportar SRT" Command="{Binding Transcript.ExportTranscriptCommand}" CommandParameter="srt"/>
                        <Button Content="Exportar TXT" Command="{Binding Transcript.ExportTranscriptCommand}" CommandParameter="txt"/>
                        <Button Content="Exportar MD" Command="{Binding Transcript.ExportTranscriptCommand}" CommandParameter="md"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Transcript.TranscriptionProgressText}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button Content="MIGRAR A CIFRADO" Command="{Binding Detail.MigrateSessionCommand}" IsEnabled="{Binding Detail.CanUseLibraryOperations}"/>
                        <Button Content="ABRIR CARPETA" Command="{Binding Detail.OpenSelectedFolderCommand}"/>
                      </StackPanel>
                      <Border Background="{DynamicResource WarningSurface}" CornerRadius="5" Padding="8" Margin="0,8,0,0">
                        <StackPanel Spacing="5">
                          <TextBlock Text="ZONA DE PELIGRO" Foreground="{DynamicResource WarningGlyph}" FontWeight="Bold"/>
                          <Button Content="ELIMINAR SESIÓN" Classes="danger" HorizontalAlignment="Left" Command="{Binding Detail.DeleteSessionCommand}" IsEnabled="{Binding Detail.CanUseLibraryOperations}"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
              <TextBlock Grid.Row="2" Text="{Binding Library.LibraryCountText}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
            </Grid>
          </Border>

          <Border Grid.RowSpan="2" IsVisible="{Binding IsSettingsPage}" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="AJUSTES" Classes="h2"/>
                <TextBlock Text="Carpeta de grabaciones" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox Text="{Binding Settings.RecordingsDirectoryText, Mode=TwoWay}"/><Button Grid.Column="1" Content="Examinar…" Command="{Binding Settings.BrowseRecordingsFolderCommand}"/></Grid>
                <TextBlock Text="{Binding Settings.RecordingsDirectoryStatus}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                <TextBlock Text="Ejecutable de Whisper" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox Text="{Binding Settings.WhisperExecutableText, Mode=TwoWay}"/><Button Grid.Column="1" Content="Examinar…" Command="{Binding Settings.BrowseWhisperExecutableCommand}"/></Grid>
                <TextBlock Text="{Binding Settings.WhisperExecutableStatus}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                <TextBlock Text="Modelo Whisper (.bin)" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox Text="{Binding Settings.WhisperModelText, Mode=TwoWay}"/><Button Grid.Column="1" Content="Examinar…" Command="{Binding Settings.BrowseWhisperModelCommand}"/></Grid>
                <TextBlock Text="{Binding Settings.WhisperModelStatus}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Button Content="Probar Whisper" Command="{Binding Settings.TestWhisperCommand}" IsEnabled="{Binding Settings.CanTestWhisper}" ToolTip.Tip="Ejecutar whisper-cli --help con límite de 15 segundos; no carga el modelo"/>
                  <TextBlock Grid.Column="1" Text="{Binding Settings.WhisperTestStatus}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
                <TextBlock Text="Idioma de transcripción" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                <ComboBox SelectedIndex="{Binding Settings.LanguageSelectionIndex, Mode=TwoWay}" MinWidth="220">
                  <ComboBoxItem Content="Español"/>
                  <ComboBoxItem Content="Inglés"/>
                  <ComboBoxItem Content="Francés"/>
                  <ComboBoxItem Content="Alemán"/>
                  <ComboBoxItem Content="Portugués"/>
                  <ComboBoxItem Content="Auto-detectar"/>
                  <ComboBoxItem Content="Código personalizado"/>
                </ComboBox>
                <TextBox Text="{Binding Settings.WhisperLanguageText, Mode=TwoWay}" MinWidth="180" IsVisible="{Binding Settings.IsCustomLanguage}" PlaceholderText="Código de idioma"/>
                <TextBlock Text="Retención de sesiones (días; 0 desactiva)" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Settings.RetentionSettingsText, Mode=TwoWay}" MinWidth="100"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Aplicar retención ahora" Command="{Binding Settings.ApplyRetentionCommand}" IsEnabled="{Binding Settings.CanApplyRetention}" ToolTip.Tip="Eliminar sesiones que superan los días configurados; requiere confirmación"/>
                  <TextBlock Text="{Binding Settings.RetentionStatusText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="Aviso de poco espacio (GB)" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Settings.MinimumFreeSpaceGbText, Mode=TwoWay}" MinWidth="100"/>
                <CheckBox Content="Transcribir automáticamente al detener una grabación completa" IsChecked="{Binding Settings.TranscribeAutomaticallyOnStop, Mode=TwoWay}" Foreground="{DynamicResource TextPrimary}"/>
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Text="Hay cambios sin guardar" Foreground="{DynamicResource WarningGlyph}" IsVisible="{Binding Settings.IsDirty}" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Content="Guardar ajustes" Classes="accent" Command="{Binding Settings.SaveSettingsCommand}"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Border Grid.RowSpan="2" IsVisible="{Binding IsLogPage}" Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="12">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock Text="REGISTRO DE LA SESIÓN" Classes="h2" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Copiar" Command="{Binding Log.CopyLogCommand}" ToolTip.Tip="Copiar el registro visible"/>
                <Button Grid.Column="2" Content="Limpiar" Command="{Binding Log.ClearLogCommand}" ToolTip.Tip="Vaciar el registro (máximo 2000 líneas)"/>
              </Grid>
              <TextBox x:Name="LogBox" Grid.Row="1" Text="{Binding Log.LogText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="monospace" FontSize="11"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{StaticResource CardRadius}" Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
        <TextBlock Text="{Binding EncryptionStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding DiskStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding OperationStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="3" Text="{Binding WhisperStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
