<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Transcriptor.UI</AssemblyName>
    <RootNamespace>Transcriptor.UI</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- MainWindow is composition-root-created; Avalonia runtime loading is not used for it. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf;Assets/Fonts/*.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../transcription/Transcriptor.Transcription.csproj" />
  </ItemGroup>
</Project>
