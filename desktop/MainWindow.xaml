<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Transcriptor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcriptor" Width="460" MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        Topmost="{Binding IsChecked, ElementName=PinToggle}"
        Loaded="Window_Loaded">
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- 0 título -->
                <RowDefinition Height="Auto"/>  <!-- 1 LCD -->
                <RowDefinition Height="Auto"/>  <!-- 2 referencia -->
                <RowDefinition Height="Auto"/>  <!-- 3 autorización -->
                <RowDefinition Height="Auto"/>  <!-- 4 transporte -->
                <RowDefinition Height="*"/>     <!-- 5 cajón (pestañas) -->
                <RowDefinition Height="Auto"/>  <!-- 6 pie -->
            </Grid.RowDefinitions>

            <!-- Barra de título propia -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource InputBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Height="24" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,4,0" VerticalAlignment="Center">
                        <ToggleButton x:Name="PinToggle" Style="{StaticResource IconToggle}" Content="&#xE718;" Height="22"
                                      ToolTip="Mantener siempre visible" AutomationProperties.Name="Mantener siempre visible"/>
                        <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;" Height="22"
                                ToolTip="Minimizar" AutomationProperties.Name="Minimizar" Click="Minimize_Click"/>
                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE8BB;" Height="22"
                                ToolTip="Cerrar" AutomationProperties.Name="Cerrar" Click="Close_Click" Margin="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="TRANSCRIPTOR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource LcdBrush}"/>
                        <TextBlock x:Name="ModeText" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="8,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Pantalla LCD: tiempo, estado y niveles -->
            <Border Grid.Row="1" Margin="6,6,6,4" Padding="10,6" Background="{DynamicResource LcdBgBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource LcdBrush}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{DynamicResource LcdBrush}" BlurRadius="8" ShadowDepth="0" Opacity="0.45"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="StatusText" Text="LISTO" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource LcdBrush}" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="YO" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource LcdDimBrush}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="MicLevel" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="MicLevelText" Grid.Row="0" Grid.Column="2" Text="En espera" FontFamily="Consolas" FontSize="9"
                                   Foreground="{DynamicResource LcdDimBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SIS" FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource LcdDimBrush}" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="SystemLevel" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="SystemLevelText" Grid.Row="2" Grid.Column="2" Text="En espera" FontFamily="Consolas" FontSize="9"
                                   Foreground="{DynamicResource LcdDimBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Referencia de la sesión (equivale a la línea de título del reproductor) -->
            <DockPanel Grid.Row="2" Margin="6,0,6,4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="REF" Style="{StaticResource FieldLabel}" Margin="4,0,8,0" VerticalAlignment="Center"/>
                <TextBox x:Name="ReferenceBox" Text="Llamada" ToolTip="Referencia de la llamada" Padding="6,2" FontFamily="Consolas"
                         Foreground="{DynamicResource LcdBrush}" Background="{DynamicResource LcdBgBrush}"/>
            </DockPanel>

            <!-- Autorización de grabación -->
            <CheckBox x:Name="ConsentCheckBox" Grid.Row="3" Margin="10,0,10,4" IsChecked="False"
                      ToolTip="Confirmo que tengo autorización para grabar a todas las personas involucradas y conservar el audio.">
                <TextBlock Text="Autorizo grabar a todas las personas involucradas y conservar el audio" FontSize="10"
                           TextTrimming="CharacterEllipsis"/>
            </CheckBox>

            <!-- Transporte + botón del cajón -->
            <DockPanel Grid.Row="4" Margin="6,0,6,6" LastChildFill="False">
                <ToggleButton x:Name="DrawerToggle" DockPanel.Dock="Right" Style="{StaticResource IconToggle}" Content="&#xE700;"
                              Width="34" Height="28" Margin="4,0,0,0" FontSize="14"
                              ToolTip="Lista, texto, registro, dispositivos y ajustes" AutomationProperties.Name="Mostrar u ocultar paneles"
                              Checked="Drawer_Changed" Unchecked="Drawer_Changed"/>
                <Button x:Name="StartButton" Style="{StaticResource TransportButton}" Content="&#x25CF;" Foreground="{DynamicResource RecBrush}"
                        MinWidth="40" Height="28" Padding="8,0" ToolTip="Iniciar grabación" AutomationProperties.Name="Iniciar grabación" Click="StartRecording_Click"/>
                <Button x:Name="PauseRecordingButton" Style="{StaticResource TransportButton}" Content="Ⅱ" IsEnabled="False"
                        MinWidth="40" Height="28" Padding="8,0" ToolTip="Pausar o reanudar grabación" AutomationProperties.Name="Pausar o reanudar grabación" Click="PauseRecording_Click"/>
                <Button x:Name="StopButton" Style="{StaticResource TransportButton}" Content="&#x25A0;" IsEnabled="False"
                        MinWidth="40" Height="28" Padding="8,0" ToolTip="Detener grabación" AutomationProperties.Name="Detener grabación" Click="StopRecording_Click"/>
                <Button x:Name="TranscribeButton" Style="{StaticResource TransportButton}" Content="&#x25B6;  TRANSCRIBIR" FontSize="11"
                        Height="28" Padding="10,0" ToolTip="Transcribir las sesiones pendientes" Click="Transcribe_Click"/>
                <Button x:Name="CancelTranscriptionButton" Style="{StaticResource TransportButton}" Content="&#x2715;" IsEnabled="False"
                        MinWidth="40" Height="28" Padding="8,0" ToolTip="Cancelar transcripción" AutomationProperties.Name="Cancelar transcripción" Click="CancelTranscription_Click"/>
            </DockPanel>

            <!-- Cajón: lista, texto, registro, dispositivos y ajustes -->
            <TabControl x:Name="TabArea" Grid.Row="5" Margin="8,4,8,0" Visibility="Collapsed">
                <TabItem Header="LISTA">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="RecordingCountText" Text="Sesiones guardadas" FontSize="11" Foreground="{DynamicResource DimBrush}" Margin="2,0,0,4"/>
                        <ListBox x:Name="RecordingList" Grid.Row="1" DisplayMemberPath="Title" SelectionChanged="RecordingList_SelectionChanged"/>
                        <TextBlock x:Name="RecordingDetailsText" Grid.Row="2" Text="Selecciona una sesión para ver sus pistas." TextWrapping="Wrap"
                                   Foreground="{DynamicResource DimBrush}" FontSize="11" Margin="2,6,2,4"/>
                        <WrapPanel Grid.Row="3" Margin="0,2,0,0">
                            <Button x:Name="PlayMicrophoneButton" Content="&#x25B6; YO" Padding="8,3" ToolTip="Reproducir micrófono" Click="PlayMicrophone_Click"/>
                            <Button x:Name="PlayClientButton" Content="&#x25B6; SIS" Padding="8,3" ToolTip="Reproducir audio del sistema" Click="PlayClient_Click"/>
                            <Button x:Name="StopPlaybackButton" Style="{StaticResource IconButton}" Content="&#xE71A;" ToolTip="Detener audio"
                                    AutomationProperties.Name="Detener audio" Click="StopPlayback_Click"/>
                            <Button x:Name="OpenRecordingFolderButton" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Abrir carpeta de la sesión"
                                    AutomationProperties.Name="Abrir carpeta de la sesión" Click="OpenRecordingFolder_Click"/>
                            <Button x:Name="RefreshRecordingsButton" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Actualizar lista"
                                    AutomationProperties.Name="Actualizar lista" Click="RefreshRecordings_Click"/>
                            <Button x:Name="MigrateButton" Style="{StaticResource IconButton}" Content="&#xE72E;" ToolTip="Migrar a cifrado"
                                    AutomationProperties.Name="Migrar a cifrado" Click="MigrateRecording_Click"/>
                            <Button x:Name="RetentionButton" Style="{StaticResource IconButton}" Content="&#xE916;" ToolTip="Aplicar retención"
                                    AutomationProperties.Name="Aplicar retención" Click="ApplyRetention_Click"/>
                            <Button x:Name="DeleteSessionButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Eliminar sesión"
                                    AutomationProperties.Name="Eliminar sesión" Click="DeleteRecording_Click"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="TEXTO">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TranscriptStatusText" Text="Selecciona una sesión con transcripción." Foreground="{DynamicResource DimBrush}"
                                   FontSize="11" Margin="2,0,0,6" TextWrapping="Wrap"/>
                        <DockPanel Grid.Row="1" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE721;" Margin="4,0,0,0" ToolTip="Buscar siguiente"
                                    AutomationProperties.Name="Buscar siguiente" Click="SearchTranscript_Click"/>
                            <TextBox x:Name="TranscriptSearchBox" ToolTip="Buscar texto en la transcripción" KeyDown="TranscriptSearchBox_KeyDown"/>
                        </DockPanel>
                        <TextBox x:Name="TranscriptTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="12" Background="{DynamicResource LcdBgBrush}" Foreground="{DynamicResource LcdBrush}"/>
                    </Grid>
                </TabItem>

                <TabItem Header="LOG">
                    <TextBox x:Name="ActivityLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas" FontSize="11" Background="{DynamicResource LcdBgBrush}" Foreground="{DynamicResource DimBrush}"/>
                </TabItem>

                <TabItem Header="DISP">
                    <Grid x:Name="SessionPanel" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="MIC" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MicrophoneDeviceBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Dispositivo de entrada (micrófono)"/>
                        <TextBlock Grid.Row="1" Text="SIS" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="OutputDeviceBox" Grid.Row="1" Grid.Column="1" Margin="0,4,4,0"
                                  DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Dispositivo de salida (audio del sistema)"/>
                        <Button x:Name="RefreshDevicesButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE72C;"
                                Margin="0,4,0,0" Height="26" ToolTip="Actualizar dispositivos" AutomationProperties.Name="Actualizar dispositivos"
                                Click="RefreshDevices_Click"/>
                    </Grid>
                </TabItem>

                <TabItem Header="AJUSTES">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="CARPETA DE GRABACIONES" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                            <DockPanel>
                                <Button x:Name="BrowseRecordingsButton" DockPanel.Dock="Right" Content="..." Margin="4,0,0,0" Padding="9,3" Click="BrowseRecordings_Click"/>
                                <TextBox x:Name="RecordingsPathBox" IsReadOnly="True"/>
                            </DockPanel>
                            <TextBlock Text="EJECUTABLE WHISPER.CPP" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button x:Name="BrowseWhisperExecutableButton" DockPanel.Dock="Right" Content="..." Margin="4,0,0,0" Padding="9,3" Click="BrowseWhisperExecutable_Click"/>
                                <TextBox x:Name="WhisperExecutableBox"/>
                            </DockPanel>
                            <TextBlock Text="MODELO WHISPER (.BIN)" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button x:Name="BrowseWhisperModelButton" DockPanel.Dock="Right" Content="..." Margin="4,0,0,0" Padding="9,3" Click="BrowseWhisperModel_Click"/>
                                <TextBox x:Name="WhisperModelBox"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="IDIOMA (es, en, auto)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="WhisperLanguageBox" Text="es" ToolTip="Código de idioma de Whisper. Ej.: es, en, auto"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="RETENCIÓN (DÍAS)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="RetentionDaysBox" Text="0" ToolTip="0 = desactivado; máximo 3650"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="APARIENCIA" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
                            <ComboBox x:Name="ThemeModeComboBox" SelectedValuePath="Tag" ToolTip="Selecciona el tema visual de la aplicación">
                                <ComboBoxItem Content="Oscuro" Tag="Dark"/>
                                <ComboBoxItem Content="Claro" Tag="Light"/>
                                <ComboBoxItem Content="Alto contraste" Tag="HighContrast"/>
                                <ComboBoxItem Content="Sistema (alto contraste automático)" Tag="System"/>
                            </ComboBox>
                            <CheckBox x:Name="MiniModeAutoShowCheckBox" Content="Mostrar Mini-Mode automáticamente al grabar"
                                      Margin="0,12,0,0" IsChecked="True"/>
                            <Button x:Name="SaveSettingsButton" Content="Guardar configuración" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="FooterText" Grid.Row="6" Margin="10,6,10,6" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource DimBrush}"
                       Visibility="Collapsed"
                       Text="El audio se procesa localmente. Asegúrate de contar con autorización para grabar y conservar las llamadas."/>
        </Grid>
    </Border>
</Window>
