<Window x:Class="Transcriptor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcriptor" Height="720" Width="1000" MinHeight="620" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="TRANSCRIPTOR" FontSize="12" FontWeight="Bold" Foreground="#2563EB" />
                <TextBlock Text="Centro de grabación" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                <TextBlock Text="Captura local de dos pistas y transcripción con Whisper.cpp" Foreground="#64748B" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#DBEAFE" CornerRadius="18" Padding="13,7">
                <TextBlock x:Name="StatusText" Text="LISTO" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MICRÓFONO · YO" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="MicLevelText" Text="En espera" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,9"/>
                    <ProgressBar x:Name="MicLevel" Height="8" Minimum="0" Maximum="100" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AUDIO DEL SISTEMA · CLIENTE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="SystemLevelText" Text="En espera" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,9"/>
                    <ProgressBar x:Name="SystemLevel" Height="8" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="SESIÓN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock Text="Referencia de llamada" FontWeight="SemiBold" Margin="0,15,0,6"/>
                    <TextBox x:Name="ReferenceBox" Text="Llamada" />
                    <TextBlock Text="Carpeta de grabaciones" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RecordingsPathBox" Grid.Column="0" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Cambiar" Click="BrowseRecordings_Click"/>
                    </Grid>
                    <TextBlock Text="Herramientas .NET" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,22,0,5"/>
                    <TextBlock Text="Ruta de rec.dll" FontWeight="SemiBold" Margin="0,7,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RecorderDllBox" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="..." Click="BrowseRecorder_Click"/>
                    </Grid>
                    <TextBlock Text="Ruta de transcriptor-transcribe.dll" FontWeight="SemiBold" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TranscriberDllBox" Grid.Column="0"/>
                        <Button Grid.Column="1" Content="..." Click="BrowseTranscriber_Click"/>
                    </Grid>
                    <Separator Margin="0,22,0,18"/>
                    <WrapPanel>
                        <Button x:Name="StartButton" Content="Iniciar grabación" Background="#2563EB" Foreground="White" Click="StartRecording_Click"/>
                        <Button x:Name="StopButton" Content="Detener" IsEnabled="False" Background="#DC2626" Foreground="White" Click="StopRecording_Click"/>
                        <Button x:Name="TranscribeButton" Content="Transcribir pendientes" Click="Transcribe_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,22,0,0"/>
                    <TextBlock Text="Tiempo de grabación" Foreground="#64748B" FontSize="12"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ACTIVIDAD" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ActivityLog" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="El audio se procesa localmente. Asegúrate de contar con autorización para grabar y conservar las llamadas." Foreground="#64748B" FontSize="11" Margin="2,16,0,0"/>
    </Grid>
</Window>
