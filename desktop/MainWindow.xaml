<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Transcriptor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcriptor" Height="820" Width="1080" MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="TRANSCRIPTOR" FontSize="12" FontWeight="Bold" Foreground="#2563EB" />
                <TextBlock Text="Centro de grabación" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,4,0,0"/>
                <TextBlock Text="Captura local de dos pistas y transcripción con Whisper.cpp" Foreground="#64748B" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#DBEAFE" CornerRadius="18" Padding="13,7">
                <TextBlock x:Name="StatusText" Text="LISTO" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"/>
            </Border>
        </Grid>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MICRÓFONO · YO" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                    <TextBlock x:Name="MicLevelText" Text="En espera" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,9"/>
                    <ProgressBar x:Name="MicLevel" Height="8" Minimum="0" Maximum="100" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="AUDIO DEL SISTEMA · CLIENTE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                    <TextBlock x:Name="SystemLevelText" Text="En espera" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,9"/>
                    <ProgressBar x:Name="SystemLevel" Height="8" Minimum="0" Maximum="100"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="SESIÓN" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="Referencia de llamada" FontWeight="SemiBold" Margin="0,15,0,6"/>
                        <TextBox x:Name="ReferenceBox" Text="Llamada"/>
                        <TextBlock Text="Dispositivo de entrada · Micrófono" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <ComboBox x:Name="MicrophoneDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <TextBlock Text="Dispositivo de salida · Audio del sistema" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <ComboBox x:Name="OutputDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        <Button Content="Actualizar dispositivos" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RefreshDevices_Click"/>
                        <TextBlock Text="Carpeta de grabaciones" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="RecordingsPathBox" Grid.Column="0" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Cambiar" Click="BrowseRecordings_Click"/>
                        </Grid>
                        <TextBlock Text="Motor de transcripción" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,22,0,5"/>
                        <TextBlock Text="Ejecutable Whisper.cpp" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="WhisperExecutableBox" Grid.Column="0"/>
                            <Button Grid.Column="1" Content="..." Click="BrowseWhisperExecutable_Click"/>
                        </Grid>
                        <TextBlock Text="Modelo Whisper (.bin)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="WhisperModelBox" Grid.Column="0"/>
                            <Button Grid.Column="1" Content="..." Click="BrowseWhisperModel_Click"/>
                        </Grid>
                        <TextBlock Text="Idioma de transcripción (código Whisper)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <TextBox x:Name="WhisperLanguageBox" Text="es" ToolTip="Ej.: es, en, auto"/>
                        <TextBlock Text="Plazo de retención (días; 0 = desactivado)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                        <TextBox x:Name="RetentionDaysBox" Text="0"/>
                        <Button Content="Guardar configuración" HorizontalAlignment="Left" Margin="0,14,0,0" Click="SaveSettings_Click"/>
                        <Separator Margin="0,22,0,18"/>
                        <WrapPanel>
                            <Button x:Name="StartButton" Content="Iniciar grabación" Background="#2563EB" Foreground="White" Click="StartRecording_Click"/>
                            <Button x:Name="StopButton" Content="Detener" IsEnabled="False" Background="#DC2626" Foreground="White" Click="StopRecording_Click"/>
                            <Button x:Name="TranscribeButton" Content="Transcribir pendientes" Click="Transcribe_Click"/>
                        </WrapPanel>
                        <CheckBox x:Name="ConsentCheckBox" Margin="0,16,0,0" IsChecked="False">
                            <TextBlock Text="Confirmo que tengo autorización para grabar a todas las personas involucradas y conservar el audio." TextWrapping="Wrap"/>
                        </CheckBox>
                        <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="24" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,22,0,0"/>
                        <TextBlock Text="Tiempo de grabación" Foreground="#64748B" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16">
                <TabControl BorderThickness="0">
                    <TabItem Header="Grabaciones">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="RecordingCountText" Text="Sesiones guardadas" FontSize="12" Foreground="#64748B" Margin="2,0,0,8"/>
                            <ListBox x:Name="RecordingList" Grid.Row="1" DisplayMemberPath="Title" SelectionChanged="RecordingList_SelectionChanged" BorderThickness="0"/>
                            <TextBlock x:Name="RecordingDetailsText" Grid.Row="2" Text="Selecciona una sesión para ver sus pistas." TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="2,8,2,8"/>
                            <WrapPanel Grid.Row="3">
                                <Button x:Name="MigrateButton" Content="Migrar a cifrado" Click="MigrateRecording_Click"/>
                                <Button x:Name="DeleteSessionButton" Content="Eliminar sesión" Click="DeleteRecording_Click"/>
                                <Button x:Name="RetentionButton" Content="Aplicar retención" Click="ApplyRetention_Click"/>
                                <Button Content="Reproducir micrófono" Click="PlayMicrophone_Click"/>
                                <Button Content="Reproducir audio del sistema" Click="PlayClient_Click"/>
                                <Button Content="Detener audio" Click="StopPlayback_Click"/>
                                <Button Content="Abrir carpeta" Click="OpenRecordingFolder_Click"/>
                                <Button x:Name="RefreshRecordingsButton" Content="Actualizar lista" Click="RefreshRecordings_Click"/>
                            </WrapPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Transcripción">
                        <Grid Margin="4,12,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="TranscriptStatusText" Text="Selecciona una sesión con transcripción." Foreground="#64748B" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"/>
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Buscar siguiente" Click="SearchTranscript_Click"/>
                                <TextBox x:Name="TranscriptSearchBox" Margin="0,0,8,0" ToolTip="Buscar texto en la transcripción" KeyDown="TranscriptSearchBox_KeyDown"/>
                            </DockPanel>
                            <TextBox x:Name="TranscriptTextBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" BorderThickness="0" Background="#F8FAFC"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Actividad">
                        <DockPanel Margin="4,12,4,4">
                            <TextBlock DockPanel.Dock="Top" Text="REGISTRO DE ACTIVIDAD" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,12"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="ActivityLog" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled" FontFamily="Consolas" FontSize="12"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="El audio se procesa localmente. Asegúrate de contar con autorización para grabar y conservar las llamadas." Foreground="#64748B" FontSize="11" Margin="2,16,0,0"/>
    </Grid>
</Window>
