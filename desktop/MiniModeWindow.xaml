<Window x:Class="Transcriptor.Desktop.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcriptor — Mini-Mode"
        Width="420" Height="130" MinWidth="220" MinHeight="48"
        WindowStartupLocation="Manual" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        Background="#171A1F" Foreground="#F2F4F7"
        FontFamily="Segoe UI" FontSize="12"
        Loaded="MiniWindow_Loaded" IsVisibleChanged="MiniWindow_IsVisibleChanged" Closing="MiniWindow_Closing" SizeChanged="MiniWindow_SizeChanged"
        PreviewKeyDown="MiniWindow_PreviewKeyDown" Focusable="True">
    <Border x:Name="RootBorder" BorderBrush="#353B44" BorderThickness="1" CornerRadius="12" Padding="4"
            MouseLeftButtonDown="Header_MouseLeftButtonDown" ContextMenuOpening="Root_ContextMenuOpening">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Detener grabación" Click="Stop_Click"/>
                <MenuItem Header="Cancelar transcripción" Click="CancelTranscription_Click"/>
                <MenuItem Header="Mantener siempre visible" IsCheckable="True" Click="ContextTopmost_Click"/>
                <Separator/>
                <MenuItem Header="Cambiar tamaño">
                    <MenuItem Header="Ultra-compacto" Tag="250,48" Click="PresetSize_Click"/>
                    <MenuItem Header="Compacto" Tag="380,64" Click="PresetSize_Click"/>
                    <MenuItem Header="Estándar" Tag="420,130" Click="PresetSize_Click"/>
                    <MenuItem Header="Extendido" Tag="480,166" Click="PresetSize_Click"/>
                </MenuItem>
                <MenuItem Header="Abrir ventana principal" Click="Expand_Click"/>
                <MenuItem Header="Cerrar Mini-Mode" Click="CloseMini_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid KeyboardNavigation.TabNavigation="Cycle">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="HeaderPanel" Grid.Row="0" LastChildFill="True">
                <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="TopmostToggle" Content="📌" MinWidth="44" MinHeight="44"
                                  ToolTip="Mantener siempre visible" AutomationProperties.Name="Mantener siempre visible" Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                    <Button x:Name="ExpandButton" Content="↗" MinWidth="44" MinHeight="44" ToolTip="Abrir ventana principal" AutomationProperties.Name="Abrir ventana principal" Click="Expand_Click"/>
                    <Button x:Name="CloseMiniButton" Content="×" MinWidth="44" MinHeight="44" ToolTip="Cerrar Mini-Mode" AutomationProperties.Name="Cerrar Mini-Mode" Click="CloseMini_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="● REC" AutomationProperties.Name="Estado de la grabación" AutomationProperties.LiveSetting="Polite" Foreground="#E81123" FontWeight="Bold"
                               FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ElapsedText" Text="00:00:00" AutomationProperties.Name="Duración de la grabación" AutomationProperties.LiveSetting="Polite" FontFamily="Consolas"
                               FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EncryptionCompactText" Text="🔒 AES-256" Foreground="#9CA8B7"
                               FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                               AutomationProperties.Name="Cifrado AES-256-GCM activo"/>
                    <Button x:Name="CompactPauseButton" Content="Ⅱ" MinWidth="44" MinHeight="44" Visibility="Collapsed"
                            AutomationProperties.Name="Pausar o reanudar grabación" Click="Pause_Click"/>
                </StackPanel>
            </DockPanel>
            <Grid x:Name="RecordingPanel" Grid.Row="1" Margin="0,2,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="YO" VerticalAlignment="Center" FontWeight="Bold"/>
                <ProgressBar x:Name="MicLevel" AutomationProperties.Name="Nivel de micrófono Yo" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="MicLevelText" AutomationProperties.Name="Porcentaje de nivel de micrófono" Grid.Row="0" Grid.Column="2" Text="0%" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="CLIENTE" VerticalAlignment="Center" FontWeight="Bold" Margin="0,5,0,0"/>
                <ProgressBar x:Name="SystemLevel" AutomationProperties.Name="Nivel de audio Cliente" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="SystemLevelText" AutomationProperties.Name="Porcentaje de nivel de audio del cliente" Grid.Row="1" Grid.Column="2" Text="0%" TextAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="SessionText" AutomationProperties.Name="Estado y referencia de sesión" AutomationProperties.LiveSetting="Polite" Grid.Row="2" Grid.ColumnSpan="3" TextTrimming="CharacterEllipsis"
                           Foreground="#9CA8B7" FontSize="10" Margin="0,6,0,0"/>
            </Grid>
            <DockPanel x:Name="IdlePanel" Grid.Row="1" Visibility="Collapsed" LastChildFill="True" Margin="0,4,0,4">
                <TextBlock x:Name="IdleSessionText" Text="Selecciona una sesión" TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Sesión seleccionada" AutomationProperties.LiveSetting="Polite"
                           VerticalAlignment="Center" Foreground="#9CA8B7" Margin="0,0,8,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PlayMicrophoneMiniButton" Content="▶ YO" MinWidth="72" MinHeight="40"
                            AutomationProperties.Name="Reproducir pista de micrófono" Click="PlayMicrophoneMini_Click"/>
                    <Button x:Name="PlayClientMiniButton" Content="▶ CLIENTE" MinWidth="88" MinHeight="40" Margin="5,0,0,0"
                            AutomationProperties.Name="Reproducir pista de audio del cliente" Click="PlayClientMini_Click"/>
                    <Button x:Name="StopPlaybackMiniButton" Content="■" MinWidth="44" MinHeight="40" Margin="5,0,0,0"
                            AutomationProperties.Name="Detener reproducción" Click="StopPlaybackMini_Click"/>
                </StackPanel>
            </DockPanel>
            <DockPanel x:Name="TranscriptionPanel" Grid.Row="1" Visibility="Collapsed" LastChildFill="True">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TranscriptionText" Text="Preparando transcripción…" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <ProgressBar IsIndeterminate="True" Height="8" AutomationProperties.Name="Progreso de transcripción" AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="CancelTranscriptionButton" Content="Cancelar" MinWidth="92" MinHeight="44"
                        AutomationProperties.Name="Cancelar transcripción" Click="CancelTranscription_Click"/>
            </DockPanel>
            <DockPanel x:Name="RecordingControls" Grid.Row="2">
                <TextBlock Text="🔒 Cifrado AES-256-GCM" Foreground="#9CA8B7" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PauseButton" Content="Ⅱ Pausar" MinWidth="92" MinHeight="44" AutomationProperties.Name="Pausar o reanudar grabación" Click="Pause_Click"/>
                    <Button x:Name="StopButton" Content="■ Detener" MinWidth="92" MinHeight="44" Margin="6,0,0,0"
                            AutomationProperties.Name="Detener ambas pistas" Click="Stop_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
