<Window x:Class="Transcriptor.Desktop.MiniModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcriptor — Mini-Mode"
        Width="420" Height="166" MinWidth="220" MinHeight="48"
        WindowStartupLocation="Manual" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        Background="#171A1F" Foreground="#F2F4F7"
        FontFamily="Segoe UI" FontSize="12"
        Loaded="MiniWindow_Loaded" Closing="MiniWindow_Closing" SizeChanged="MiniWindow_SizeChanged">
    <Border x:Name="RootBorder" BorderBrush="#353B44" BorderThickness="1" CornerRadius="8" Padding="10"
            MouseLeftButtonDown="Header_MouseLeftButtonDown" ContextMenuOpening="Root_ContextMenuOpening">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Detener grabación" Click="Stop_Click"/>
                <MenuItem Header="Cancelar transcripción" Click="CancelTranscription_Click"/>
                <MenuItem x:Name="ContextTopmostMenuItem" Header="Mantener siempre visible" IsCheckable="True" Click="ContextTopmost_Click"/>
                <Separator/>
                <MenuItem Header="Abrir ventana principal" Click="Expand_Click"/>
                <MenuItem Header="Cerrar Mini-Mode" Click="CloseMini_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel x:Name="HeaderPanel" Grid.Row="0" LastChildFill="True">
                <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="TopmostToggle" Content="📌" MinWidth="44" MinHeight="44"
                                  ToolTip="Mantener siempre visible" AutomationProperties.Name="Mantener siempre visible" Checked="Topmost_Changed" Unchecked="Topmost_Changed"/>
                    <Button x:Name="ExpandButton" Content="↗" MinWidth="44" MinHeight="44" ToolTip="Abrir ventana principal" AutomationProperties.Name="Abrir ventana principal" Click="Expand_Click"/>
                    <Button x:Name="CloseMiniButton" Content="×" MinWidth="44" MinHeight="44" ToolTip="Cerrar Mini-Mode" AutomationProperties.Name="Cerrar Mini-Mode" Click="CloseMini_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" Text="● REC" Foreground="#E81123" FontWeight="Bold"
                               FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas"
                               FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="CompactPauseButton" Content="Ⅱ" MinWidth="44" MinHeight="44" Visibility="Collapsed"
                            AutomationProperties.Name="Pausar o reanudar grabación" Click="Pause_Click"/>
                </StackPanel>
            </DockPanel>
            <Grid x:Name="RecordingPanel" Grid.Row="1" Margin="0,6,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="52"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="YO" VerticalAlignment="Center" FontWeight="Bold"/>
                <ProgressBar x:Name="MicLevel" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="MicLevelText" Grid.Row="0" Grid.Column="2" Text="0%" TextAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="CLIENTE" VerticalAlignment="Center" FontWeight="Bold" Margin="0,5,0,0"/>
                <ProgressBar x:Name="SystemLevel" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Height="12" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="SystemLevelText" Grid.Row="1" Grid.Column="2" Text="0%" TextAlignment="Right" VerticalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="SessionText" Grid.Row="2" Grid.ColumnSpan="3" TextTrimming="CharacterEllipsis"
                           Foreground="#9CA8B7" FontSize="10" Margin="0,6,0,0"/>
            </Grid>
            <DockPanel x:Name="TranscriptionPanel" Grid.Row="1" Visibility="Collapsed" LastChildFill="True">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TranscriptionText" Text="Preparando transcripción…" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    <ProgressBar IsIndeterminate="True" Height="8" Margin="0,8,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" x:Name="CancelTranscriptionButton" Content="Cancelar" MinWidth="92" MinHeight="44"
                        AutomationProperties.Name="Cancelar transcripción" Click="CancelTranscription_Click"/>
            </DockPanel>
            <DockPanel x:Name="RecordingControls" Grid.Row="2">
                <TextBlock Text="🔒 Cifrado AES-256-GCM" Foreground="#9CA8B7" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="PauseButton" Content="Ⅱ Pausar" MinWidth="92" MinHeight="44" AutomationProperties.Name="Pausar o reanudar grabación" Click="Pause_Click"/>
                    <Button x:Name="StopButton" Content="■ Detener" MinWidth="92" MinHeight="44" Margin="6,0,0,0"
                            AutomationProperties.Name="Detener ambas pistas" Click="Stop_Click"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
