<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Transcriptor.Desktop</AssemblyName>
    <RootNamespace>Transcriptor.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.FileSystem.AccessControl" Version="6.0.1" />
    <PackageReference Include="System.Security.Principal.Windows" Version="6.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../rec/Rec.csproj" />
    <ProjectReference Include="../transcribe/Transcriptor.Transcription.csproj" />
  </ItemGroup>
</Project>
